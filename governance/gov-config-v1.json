      "-",
      "kg",
      "g",
      "m",
      "cm",
      "mm",
      "km",
      "s",
      "ms",
      "K",
      "Pa",
      "kPa",
      "MPa",
      "N",
      "kN",
      "W",
      "kW",
      "Hz",
      "m/s",
      "m/s2",
      "kg/m3",
      "deg",
      "rad",
      "Nm",
      "J",
      "°"
    ],
    "needle_tolerance": 1e-09,
    "context_keywords": {
      "geometry": {
        "cylinder": [
          "cylinder",
          "圆柱",
          "cylinder flow"
        ],
        "sphere": [
          "sphere",

          "cavity",
          "方腔"
        ],
        "pipe": [
          "pipe",
          "管道",
          "管流"
        ]
      }
    },
    "condition_lookback_lines": 3,
    "condition_lookback_policy": "same line first; otherwise the nearest preceding lines up to condition_lookback_lines inside the same section, merged with heading geometry"
  },

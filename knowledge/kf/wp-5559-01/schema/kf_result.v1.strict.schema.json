{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tensor://schemas/kf_result.v1.schema.json",
  "title": "KF work-package result envelope v1",
  "description": "Envelope of a Knowledge-Factory work-package result, submitted as the single ```json block of the report titled `KF-RESULT <package_id>`. Structural contract only: it fixes the five top-level keys and the provenance/outputs shape, while leaving the per-task-type payload of outputs.<file> open (held to its own manifest schema).",
  "type": "object",
  "required": ["package_id", "task_type", "report_id", "provenance", "outputs"],
  "additionalProperties": false,
  "properties": {
    "package_id": {
      "type": "string",
      "pattern": "^wp-[0-9]+-[0-9]{2}$"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "01-asset-registration",
        "02-claim-extraction",
        "03-evidence-binding",
        "04-knowledge-object"
      ]
    },
    "report_id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "provenance": {
      "type": "object",
      "required": ["source_hash", "source_field"],
      "additionalProperties": true,
      "properties": {
        "source_uri": {"type": "string"},
        "source_field": {"type": "string"},
        "source_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "producer": {"type": "string"},
        "emitted_at": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "outputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "object"}
    }
  }
}

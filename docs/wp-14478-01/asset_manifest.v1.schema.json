{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.wp-14478-01.schema.json",
  "title": "asset_manifest.v1 pinned for KF work package wp-14478-01 (task_type=01-asset-registration)",
  "description": "Locally written schema pinned by this package so that the acceptance item schema_pass is a reproducible machine check rather than an assertion. Shape = asset_manifest.v1 as used by the KF registration packages (wp-3076-01 lineage), constrained to report 14478. The canonical envelope schema is kf_result.v1.schema.json (copied verbatim from the worktree's schemas/). If the platform-side schema differs, the platform gate wins and this artifact must be revised.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "package_id", "task_type", "report_id", "objective", "source", "counts", "assets", "claims", "claims_note", "integrity", "boundaries"],
  "properties": {
    "schema": {"const": "asset_manifest.v1"},
    "package_id": {"const": "wp-14478-01"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"const": "14478"},
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["register_assets", "classify_report_type"],
      "properties": {
        "register_assets": {"const": true},
        "classify_report_type": {"const": false}
      }
    },
    "source": {
      "type": "object",
      "required": ["uri", "field", "hash_alg", "hash", "chars", "bytes_utf8", "title", "scenario_key"],
      "properties": {
        "uri": {"const": "tensor://reports/14478"},
        "field": {"const": "markdown"},
        "hash_alg": {"const": "sha256"},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "chars": {"type": "integer", "minimum": 1},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "contract_chars": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "scenario_key": {"type": "string", "minLength": 1},
        "platform_mission_id": {"type": ["integer", "null"]},
        "platform_status": {"type": ["string", "null"]},
        "platform_created_at": {"type": ["string", "null"]},
        "platform_tags": {"type": "array"},
        "platform_figures": {"type": "array"}
      }
    },
    "counts": {
      "type": "object",
      "required": ["assets", "by_class", "by_payload_status", "claims"],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "by_payload_status": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "reference_values_quoted": {"type": "integer", "minimum": 0},
        "claims": {"const": 0}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "asset_class", "label", "in_report_section", "locator", "payload", "note"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_class": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "source_field", "start_char", "end_char", "start_line", "end_line", "quote", "unique"],
            "properties": {
              "method": {"enum": ["char_span", "document"]},
              "source_field": {"const": "markdown"},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 1},
              "end_line": {"type": "integer", "minimum": 1},
              "quote": {"type": "string", "minLength": 1},
              "unique": {"type": "boolean"}
            }
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "checked_how"],
            "properties": {
              "status": {
                "enum": ["in_report_record", "external_url_declared", "external_repo_path_declared", "declared_payload_missing", "declared_in_source_only"]
              },
              "checked_how": {"type": "string", "minLength": 1},
              "declared": {"type": "object"},
              "evidence": {"type": "object"}
            }
          },
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "claims": {"type": "array", "maxItems": 0},
    "claims_note": {"type": "string", "minLength": 1},
    "integrity": {
      "type": "object",
      "required": ["hash_recomputed_locally", "hash_matches_contract", "chars_match_contract", "all_locators_unique_quotes"],
      "properties": {
        "hash_recomputed_locally": {"const": true},
        "hash_matches_contract": {"const": true},
        "chars_match_contract": {"const": true},
        "all_locators_unique_quotes": {"const": true},
        "verified_by": {"type": "string"},
        "no_file_outside_worktree_written": {"const": true},
        "other_report_ids_touched": {"const": 0}
      }
    },
    "boundaries": {
      "type": "object",
      "required": ["only_report_id", "other_reports_read", "upstream_artifacts_rewritten", "claims_marked_verified"],
      "properties": {
        "only_report_id": {"const": "14478"},
        "other_reports_read": {"const": false},
        "upstream_artifacts_rewritten": {"const": false},
        "claims_marked_verified": {"const": 0}
      }
    }
  }
}
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "asset_manifest.v1 (KF task_type=01-asset-registration, generic)",
  "description": "Generic (non report-pinned) shape of asset_manifest.json as produced by scripts/kf_wp8753_01_register.py. Derived from schemas/asset_manifest.v1.schema.json with the wp-448-01 `const` pins replaced by patterns so a package-local schema_pass is machine-checkable. The platform gate remains authoritative.",
  "type": "object",
  "required": [
    "schema",
    "package_id",
    "task_type",
    "report_id",
    "source",
    "counts",
    "assets",
    "claims",
    "id_integrity",
    "claims_empty_reason"
  ],
  "properties": {
    "schema": {
      "const": "asset_manifest.v1"
    },
    "package_id": {
      "type": "string",
      "pattern": "^wp-[A-Za-z0-9][A-Za-z0-9_.:-]*-[0-9]{2}$"
    },
    "task_type": {
      "type": "string",
      "pattern": "^[0-9]{2}(-[a-z0-9-]+)?$"
    },
    "report_id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "source": {
      "type": "object",
      "required": [
        "uri",
        "field",
        "hash_alg",
        "hash",
        "chars",
        "bytes_utf8",
        "title",
        "scenario_key"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^tensor://reports/[0-9]+$"
        },
        "field": {
          "enum": [
            "markdown",
            "summary",
            "record"
          ]
        },
        "hash_alg": {
          "const": "sha256"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "chars": {
          "type": "integer",
          "minimum": 1
        },
        "bytes_utf8": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scenario_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "counts": {
      "type": "object",
      "required": [
        "assets",
        "by_class",
        "by_resolution",
        "resolved_in_source",
        "referenced_unresolved",
        "declared_absent"
      ],
      "properties": {
        "assets": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "asset_class",
          "label",
          "in_report_section",
          "locator",
          "resolution",
          "resolution_check",
          "note"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^A[0-9]{2}$"
          },
          "asset_class": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "in_report_section": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "enum": [
              "resolved_in_source",
              "referenced_unresolved",
              "declared_absent"
            ]
          },
          "resolution_check": {
            "type": "object",
            "required": [
              "check",
              "result"
            ],
            "properties": {
              "check": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "resolved",
                  "unresolved",
                  "absent",
                  "present"
                ]
              }
            },
            "additionalProperties": true
          },
          "locator": {
            "type": "object",
            "required": [
              "method",
              "start_char",
              "end_char",
              "start_line",
              "end_line",
              "quote",
              "unique"
            ],
            "properties": {
              "method": {
                "enum": [
                  "char_span",
                  "document"
                ]
              },
              "start_char": {
                "type": "integer",
                "minimum": 0
              },
              "end_char": {
                "type": "integer",
                "minimum": 1
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "occurrences": {
                "type": "integer",
                "minimum": 1
              },
              "unique": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "text"
        ],
        "anyOf": [
          {
            "required": [
              "evidence"
            ]
          },
          {
            "required": [
              "unresolved_reason"
            ]
          },
          {
            "required": [
              "status"
            ]
          }
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 3
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "supported",
              "partially-supported",
              "unresolved",
              "refuted"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "id_integrity": {
      "type": "object",
      "required": [
        "ids_checked",
        "duplicates",
        "unique"
      ],
      "properties": {
        "unique": {
          "const": true
        }
      }
    },
    "claims_empty_reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensorknowledge.local/schemas/review_report.wp-6184-04.v1.schema.json",
  "title": "Independent review report (process 04) — local schema for wp-6184-04",
  "description": "No repository-wide review_report schema exists (ke/wp_gate.py only requires the file to be present for 04). This schema is therefore supplied by the package itself so that acceptance['schema_pass'] is machine-checkable. Field names deliberately avoid the self-attestation tokens S9 forbids.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_report_version", "review_id", "report_id", "reviewed_package", "reviewer",
    "verdict", "verdict_scope", "checks", "summary_counts", "findings",
    "semantic_fidelity", "downstream_advisories", "checks_not_run", "limitations",
    "provenance", "acceptance_selfcheck"
  ],
  "properties": {
    "review_report_version": { "const": "1.0" },
    "review_id": { "type": "string", "pattern": "^wp-[A-Za-z0-9][A-Za-z0-9_.:-]*-[0-9]{2}$" },
    "report_id": { "type": "string", "pattern": "^[0-9]+$" },
    "mission_id": { "type": ["integer", "null"] },
    "reviewed_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "task_type", "source_hash"],
      "properties": {
        "package_id": { "type": "string" },
        "task_type": { "type": "string" },
        "source_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "producer": { "type": ["string", "null"] },
        "emitted_at": { "type": ["string", "null"] }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "identity", "prompt_origin", "context_consulted", "context_excluded"],
      "properties": {
        "role": { "const": "red-team-reviewer" },
        "identity": { "type": "string", "minLength": 1 },
        "prompt_origin": { "type": "string", "minLength": 20 },
        "context_consulted": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "context_excluded": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "independence_limitations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "verdict": { "enum": ["pass", "fail", "needs-fix"] },
    "verdict_scope": { "type": "string", "minLength": 20 },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "status", "detail"],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "name": { "type": "string", "minLength": 10 },
          "status": { "enum": ["pass", "fail", "not_run"] },
          "blocking": { "type": ["boolean", "null"] },
          "detail": { "type": "string", "minLength": 1 },
          "evidence": { "type": "object" }
        }
      }
    },
    "summary_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "pass", "fail_blocking", "fail_non_blocking", "not_run"],
      "properties": {
        "checks": { "type": "integer", "minimum": 1 },
        "pass": { "type": "integer", "minimum": 0 },
        "fail_blocking": { "type": "integer", "minimum": 0 },
        "fail_non_blocking": { "type": "integer", "minimum": 0 },
        "not_run": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "blocking", "target", "statement", "impact", "remediation"],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "severity": { "enum": ["blocking", "major", "minor", "info"] },
          "blocking": { "type": "boolean" },
          "target": { "type": "string" },
          "statement": { "type": "string", "minLength": 20 },
          "source_quote": { "type": "string" },
          "impact": { "type": "string", "minLength": 10 },
          "remediation": { "type": "string", "minLength": 10 },
          "evidence": { "type": "object" }
        }
      }
    },
    "semantic_fidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["judged", "claims_reviewed", "assets_reviewed", "overall", "basis"],
      "properties": {
        "judged": { "type": "boolean" },
        "claims_reviewed": { "type": "integer", "minimum": 0 },
        "assets_reviewed": { "type": "integer", "minimum": 0 },
        "overall": { "enum": ["faithful", "faithful_with_caveats", "overstated", "unsupported"] },
        "basis": { "type": "string", "minLength": 20 },
        "residual_risk": { "type": "string" }
      }
    },
    "downstream_advisories": { "type": "array", "items": { "type": "string", "minLength": 10 } },
    "checks_not_run": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "why"],
        "properties": { "id": { "type": "string" }, "why": { "type": "string", "minLength": 10 } }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source_uri", "source_field", "source_hash", "source_chars", "tool"],
      "properties": {
        "source_uri": { "type": "string" },
        "source_field": { "enum": ["markdown", "summary", "record"] },
        "source_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "source_chars": { "type": "integer", "minimum": 1 },
        "source_snapshot": { "type": "string" },
        "upstream_kf_result_sha256": { "type": "string" },
        "tool": { "type": "string" },
        "generated_at": { "type": "string" }
      }
    },
    "acceptance_selfcheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid_json", "schema_pass", "reviewer_independent", "upstream_packages_completed"],
      "properties": {
        "valid_json": { "type": "boolean" },
        "schema_pass": { "type": "boolean" },
        "reviewer_independent": { "type": "boolean" },
        "upstream_packages_completed": { "type": "boolean" }
      }
    }
  }
}
{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "asset_manifest for wp-11267-01 (report 11267)",
 "type": "object",
 "required": [
  "schema",
  "package_id",
  "task_type",
  "report_id",
  "source",
  "counts",
  "assets",
  "claims",
  "id_integrity"
 ],
 "properties": {
  "schema": {
   "const": "asset_manifest.v1"
  },
  "package_id": {
   "const": "wp-11267-01"
  },
  "task_type": {
   "const": "01-asset-registration"
  },
  "report_id": {
   "const": "11267"
  },
  "source": {
   "type": "object",
   "required": [
    "uri",
    "field",
    "hash_alg",
    "hash",
    "chars",
    "bytes_utf8",
    "title",
    "scenario_key",
    "contract_hash",
    "hash_matches_contract"
   ],
   "properties": {
    "uri": {
     "const": "tensor://reports/11267"
    },
    "field": {
     "const": "markdown"
    },
    "hash_alg": {
     "const": "sha256"
    },
    "hash": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contract_hash": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "hash_matches_contract": {
     "const": true
    },
    "chars": {
     "type": "integer",
     "minimum": 1
    },
    "bytes_utf8": {
     "type": "integer",
     "minimum": 1
    },
    "title": {
     "type": "string",
     "minLength": 1
    },
    "scenario_key": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "counts": {
   "type": "object",
   "required": [
    "assets",
    "by_class",
    "by_resolution",
    "resolved_in_source",
    "referenced_unresolved",
    "declared_absent"
   ],
   "properties": {
    "assets": {
     "type": "integer",
     "minimum": 1
    },
    "by_class": {
     "type": "object"
    },
    "by_resolution": {
     "type": "object"
    }
   }
  },
  "assets": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "asset_id",
     "asset_class",
     "label",
     "in_report_section",
     "locator",
     "resolution",
     "resolution_check",
     "note"
    ],
    "properties": {
     "asset_id": {
      "type": "string",
      "pattern": "^A[0-9]{2}$"
     },
     "asset_class": {
      "type": "string",
      "minLength": 1
     },
     "label": {
      "type": "string",
      "minLength": 1
     },
     "in_report_section": {
      "type": "string",
      "minLength": 1
     },
     "resolution": {
      "enum": [
       "resolved_in_source",
       "referenced_unresolved",
       "declared_absent"
      ]
     },
     "resolution_check": {
      "type": "object",
      "required": [
       "check",
       "result"
      ],
      "properties": {
       "check": {
        "type": "string"
       },
       "result": {
        "enum": [
         "resolved",
         "unresolved",
         "absent",
         "present"
        ]
       }
      }
     },
     "locator": {
      "type": "object",
      "required": [
       "method",
       "start_char",
       "end_char",
       "start_line",
       "end_line",
       "quote",
       "unique"
      ],
      "properties": {
       "method": {
        "enum": [
         "char_span",
         "document"
        ]
       },
       "start_char": {
        "type": "integer",
        "minimum": 0
       },
       "end_char": {
        "type": "integer",
        "minimum": 1
       },
       "start_line": {
        "type": "integer",
        "minimum": 0
       },
       "end_line": {
        "type": "integer",
        "minimum": 0
       },
       "quote": {
        "type": "string",
        "minLength": 1
       },
       "unique": {
        "type": "boolean"
       }
      }
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "claims": {
   "type": "array",
   "description": "empty is legitimate here; any claim must carry evidence or an explicit status",
   "items": {
    "type": "object",
    "required": [
     "claim_id",
     "text"
    ],
    "anyOf": [
     {
      "required": [
       "evidence"
      ]
     },
     {
      "required": [
       "status"
      ]
     }
    ]
   }
  },
  "id_integrity": {
   "type": "object",
   "required": [
    "ids_checked",
    "duplicate_ids",
    "unique"
   ],
   "properties": {
    "unique": {
     "const": true
    }
   }
  }
 }
}
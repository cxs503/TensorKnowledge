{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/wp-9756-01/asset_manifest.schema.json",
  "title": "asset_manifest for KF work package wp-9756-01 (task_type=01-asset-registration)",
  "description": "Package-local schema pinning the shape of docs/kf/wp-9756-01/asset_manifest.json so that the acceptance item 'schema_pass' is a reproducible machine check rather than an assertion. The generic schemas/asset_manifest.v1.schema.json in this worktree is hard-pinned (const package_id=wp-448-01, const report_id=448) and therefore cannot describe this package; it was left untouched. The platform-side kf_result.v1 schema wins for the envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "package_id",
    "task_type",
    "report_id",
    "lane",
    "generated_at",
    "producer",
    "scope",
    "source",
    "identity_facts",
    "assets",
    "locators",
    "counts",
    "id_integrity",
    "claims",
    "claims_empty_reason",
    "observations",
    "limitations"
  ],
  "properties": {
    "manifest_version": {"const": "1.0"},
    "package_id": {"const": "wp-9756-01"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"const": "9756"},
    "lane": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 10},
    "producer": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["uri", "field", "fetch", "hash_alg", "hash", "hash_expected",
                   "hash_matches_contract", "chars", "chars_expected",
                   "chars_matches_contract", "bytes_utf8", "lines", "heading_count",
                   "headings", "local_copy"],
      "properties": {
        "uri": {"const": "tensor://reports/9756"},
        "field": {"const": "markdown"},
        "fetch": {"type": "string", "minLength": 1},
        "hash_alg": {"const": "sha256"},
        "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "hash_expected": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "hash_matches_contract": {"const": true},
        "chars": {"type": "integer", "minimum": 1},
        "chars_expected": {"type": "integer", "minimum": 1},
        "chars_matches_contract": {"const": true},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "lines": {"type": "integer", "minimum": 1},
        "heading_count": {"type": "integer", "minimum": 1},
        "headings": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "local_copy": {"type": "string", "minLength": 1}
      }
    },
    "identity_facts": {
      "type": "object",
      "required": ["report_id", "title", "title_matches_contract", "scenario_key",
                   "scenario_key_matches_contract", "status", "source_mission_id", "tags"],
      "properties": {
        "report_id": {"const": 9756},
        "title_matches_contract": {"const": true},
        "scenario_key": {"type": "string", "minLength": 1},
        "scenario_key_matches_contract": {"const": true},
        "status": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "kind", "name", "in_report_section", "locator",
                     "resolution", "resolution_note", "note"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^r9756:[A-Za-z0-9:_-]+$"},
          "kind": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "caption": {"type": ["string", "null"]},
          "in_report_section": {"type": "string", "minLength": 1},
          "locator": {
            "type": "object",
            "required": ["source_field", "quote", "unique"],
            "properties": {
              "source_field": {"enum": ["markdown", "record"]},
              "locator_id": {"type": "string"},
              "pointer": {"type": "string"},
              "method": {"enum": ["char_span", "document"]},
              "char_start": {"type": ["integer", "null"], "minimum": 0},
              "char_end": {"type": ["integer", "null"], "minimum": 1},
              "line": {"type": ["integer", "null"], "minimum": 1},
              "quote": {"type": "string", "minLength": 1},
              "occurrences": {"type": "integer", "minimum": 0},
              "unique": {"type": "boolean"}
            }
          },
          "resolution": {
            "enum": ["resolved_in_source", "metadata_only", "referenced_unresolved"]
          },
          "resolution_note": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1},
          "notes": {"type": "object"}
        }
      }
    },
    "locators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["locator_id", "source_field", "quote", "resolvable"],
        "properties": {
          "locator_id": {"type": "string", "minLength": 3},
          "asset_id": {"type": ["string", "null"]},
          "meaning": {"type": "string"},
          "source_field": {"enum": ["markdown", "record"]},
          "quote": {"type": "string", "minLength": 1},
          "resolvable": {"const": true},
          "char_start": {"type": ["integer", "null"]},
          "char_end": {"type": ["integer", "null"]},
          "line": {"type": ["integer", "null"]},
          "occurrences": {"type": "integer", "minimum": 1},
          "unique": {"type": "boolean"}
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["assets_total", "by_kind", "by_resolution", "locators_total",
                   "locators_resolved", "locators_unresolved", "figures_declared_in_record",
                   "figures_with_bytes"],
      "properties": {
        "assets_total": {"type": "integer", "minimum": 1},
        "by_kind": {"type": "object"},
        "by_resolution": {"type": "object"},
        "locators_total": {"type": "integer", "minimum": 1},
        "locators_resolved": {"type": "integer", "minimum": 1},
        "locators_unresolved": {"const": []},
        "locators_non_unique": {"const": []},
        "figures_declared_in_record": {"type": "integer", "minimum": 0},
        "figures_with_bytes": {"const": 0},
        "figure_probe_http_status": {"type": "object"}
      }
    },
    "id_integrity": {
      "type": "object",
      "required": ["duplicate_asset_ids", "duplicate_ids_ok", "outputs_keys",
                   "reports_other_than_9756_touched"],
      "properties": {
        "duplicate_asset_ids": {"const": []},
        "duplicate_ids_ok": {"const": true},
        "outputs_keys": {"type": "array", "minItems": 1},
        "reports_other_than_9756_touched": {"const": []}
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is the contract-correct value for this package (objective.classify_report_type=false, no extraction). If non-empty, each item must carry evidence or an explicit status.",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "anyOf": [{"required": ["evidence"]}, {"required": ["status"]}, {"required": ["unresolved_reason"]}]
      }
    },
    "claims_empty_reason": {"type": "string", "minLength": 1},
    "observations": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.v1.schema.json#wp-6939-01",
  "title": "asset_manifest.v1 (KF work package wp-6939-01, task_type=01-asset-registration)",
  "description": "Package-local schema for docs/kf/wp-6939-01/asset_manifest.json. Rationale: the shared schemas/asset_manifest.v1.schema.json in this repository is written for wp-448-01 and pins package_id/report_id via `const`, so it cannot validate this package; that file is left untouched (not this package's artifact). This schema reuses its shape and widens two enums where report 6939 forced it: (a) resolution gains `metadata_only` because the platform record stores figures[].name/caption but no png payload (artifact endpoints return 404), so no byte hash is computable; (b) locator.method gains `record_field` for that case. If the platform-side schema differs, the platform gate wins and this artifact must be revised.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package_id",
    "task_type",
    "report_id",
    "source",
    "counts",
    "assets",
    "claims",
    "claims_rationale",
    "integrity",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "asset_manifest.v1"
    },
    "package_id": {
      "const": "wp-6939-01"
    },
    "task_type": {
      "const": "01-asset-registration"
    },
    "report_id": {
      "const": "6939"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "field",
        "hash_alg",
        "hash",
        "chars",
        "bytes_utf8",
        "title",
        "scenario_key",
        "platform_figures",
        "platform_tags"
      ],
      "properties": {
        "uri": {
          "const": "tensor://reports/6939"
        },
        "field": {
          "const": "markdown"
        },
        "hash_alg": {
          "const": "sha256"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "chars": {
          "type": "integer",
          "minimum": 1
        },
        "bytes_utf8": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scenario_key": {
          "type": "string",
          "minLength": 1
        },
        "platform_figures": {
          "type": "array"
        },
        "platform_tags": {
          "type": "array"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assets",
        "by_class",
        "by_resolution",
        "resolved_in_source",
        "referenced_unresolved",
        "declared_absent",
        "metadata_only"
      ],
      "properties": {
        "assets": {
          "type": "integer",
          "minimum": 1
        },
        "by_class": {
          "type": "object"
        },
        "by_resolution": {
          "type": "object"
        },
        "resolved_in_source": {
          "type": "integer",
          "minimum": 0
        },
        "referenced_unresolved": {
          "type": "integer",
          "minimum": 0
        },
        "declared_absent": {
          "type": "integer",
          "minimum": 0
        },
        "metadata_only": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "asset_class",
          "label",
          "in_report_section",
          "locator",
          "resolution",
          "resolution_check",
          "note"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^A[0-9]{2}$"
          },
          "asset_class": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "in_report_section": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "enum": [
              "resolved_in_source",
              "metadata_only",
              "referenced_unresolved",
              "declared_absent"
            ]
          },
          "resolution_check": {
            "type": "object",
            "required": [
              "check",
              "result"
            ],
            "properties": {
              "check": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "resolved",
                  "unresolved",
                  "absent",
                  "present"
                ]
              }
            }
          },
          "locator": {
            "type": "object",
            "required": [
              "method",
              "start_char",
              "end_char",
              "start_line",
              "end_line",
              "quote",
              "unique"
            ],
            "properties": {
              "method": {
                "enum": [
                  "char_span",
                  "document",
                  "record_field"
                ]
              },
              "start_char": {
                "type": "integer",
                "minimum": 0
              },
              "end_char": {
                "type": "integer",
                "minimum": 1
              },
              "start_line": {
                "type": "integer",
                "minimum": 0
              },
              "end_line": {
                "type": "integer",
                "minimum": 0
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "unique": {
                "type": "boolean"
              },
              "record_field": {
                "type": "string"
              },
              "record_index": {
                "type": "integer",
                "minimum": 0
              },
              "record_name": {
                "type": "string"
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is a legal, complete result for this package (objective.classify_report_type=false, no extraction; contract notes: claims 允许为空数组). Any claim present must carry evidence or an explicit status.",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "text"
        ],
        "anyOf": [
          {
            "required": [
              "evidence_locator"
            ]
          },
          {
            "required": [
              "status"
            ]
          }
        ]
      }
    },
    "claims_rationale": {
      "type": "string",
      "minLength": 1
    },
    "integrity": {
      "type": "object",
      "required": [
        "quote_uniqueness",
        "hash_recomputed_locally",
        "hash_matches_contract",
        "hash_source",
        "fixture_path",
        "fixture_sha256"
      ],
      "properties": {
        "quote_uniqueness": {
          "type": "string"
        },
        "hash_recomputed_locally": {
          "type": "boolean"
        },
        "hash_matches_contract": {
          "const": true
        },
        "hash_source": {
          "type": "string"
        },
        "fixture_path": {
          "type": "string"
        },
        "fixture_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_hash",
        "source_field",
        "generated_at",
        "generator"
      ],
      "properties": {
        "source_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_field": {
          "const": "markdown"
        },
        "generated_at": {
          "type": "string"
        },
        "generator": {
          "type": "string"
        }
      }
    },
    "artifact_probe": {
      "type": "object",
      "description": "Platform probe evidence for the metadata_only verdict (GET /tensor/reports/6939/figures/<name>, /tensor/reports/6939/artifacts, /tensor/artifacts?report_id=6939). Recorded verbatim so the classification is auditable rather than asserted."
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tk.local/schemas/asset_manifest.wp-11421-01.v1.json",
  "title": "asset_manifest.v1 pinned for wp-11421-01 (report_id=11421)",
  "description": "Local pinned copy of schemas/asset_manifest.v1.schema.json. The repo-wide copy hard-codes {\"package_id\":{\"const\":\"wp-448-01\"}} and {\"source.uri\":{\"const\":\"tensor://reports/448\"}}, so it cannot validate any other package; rather than loosen the shared file (out of this package's write scope and shared by other work packages), this per-package pin keeps the identical shape and pins the identity fields to wp-11421-01 / report 11421. If the platform-side schema differs, the platform gate wins and this artifact must be revised.",
  "type": "object",
  "required": ["schema", "package_id", "task_type", "report_id", "source", "counts", "assets", "claims", "integrity"],
  "properties": {
    "schema": {"const": "asset_manifest.v1"},
    "package_id": {"const": "wp-11421-01"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"const": "11421"},
    "source": {
      "type": "object",
      "required": ["uri", "field", "hash_alg", "hash", "chars", "bytes_utf8", "title", "scenario_key"],
      "properties": {
        "uri": {"const": "tensor://reports/11421"},
        "field": {"const": "markdown"},
        "hash_alg": {"const": "sha256"},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "chars": {"type": "integer", "minimum": 1},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "scenario_key": {"const": "ship_performance"},
        "platform_figures": {"type": "array"},
        "platform_tags": {"type": "array"}
      }
    },
    "counts": {
      "type": "object",
      "required": ["assets", "by_class", "by_resolution", "resolved_in_source", "referenced_unresolved", "declared_absent"],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object"},
        "by_resolution": {"type": "object"},
        "resolved_in_source": {"type": "integer", "minimum": 0},
        "referenced_unresolved": {"type": "integer", "minimum": 0},
        "declared_absent": {"type": "integer", "minimum": 0}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "asset_class", "label", "in_report_section", "locator", "resolution", "resolution_check", "note"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_class": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "resolution": {"enum": ["resolved_in_source", "referenced_unresolved", "declared_absent"]},
          "resolution_check": {
            "type": "object",
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string"},
              "result": {"enum": ["resolved", "unresolved", "absent", "present"]}
            }
          },
          "locator": {
            "type": "object",
            "required": ["method", "start_char", "end_char", "start_line", "end_line", "quote", "unique"],
            "properties": {
              "method": {"enum": ["char_span", "document"]},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 1},
              "end_line": {"type": "integer", "minimum": 1},
              "quote": {"type": "string", "minLength": 1},
              "unique": {"type": "boolean"}
            }
          },
          "note": {"type": "string"}
        },
        "allOf": [
          {"if": {"properties": {"resolution": {"const": "resolved_in_source"}}},
           "then": {"properties": {"resolution_check": {"properties": {"result": {"enum": ["resolved", "present"]}}}}}},
          {"if": {"properties": {"resolution": {"const": "referenced_unresolved"}}},
           "then": {"properties": {"resolution_check": {"properties": {"result": {"const": "unresolved"}}}}}}
        ]
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate for this package (no extraction declared). Each claim, if any, must carry evidence or an explicit status.",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "anyOf": [{"required": ["evidence"]}, {"required": ["status"]}]
      }
    },
    "claims_note": {"type": "string"},
    "limits": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "integrity": {
      "type": "object",
      "required": ["quote_uniqueness", "hash_recomputed_locally", "hash_matches_contract"],
      "properties": {
        "quote_uniqueness": {"type": "boolean"},
        "hash_recomputed_locally": {"type": "boolean"},
        "hash_matches_contract": {"type": "boolean"},
        "duplicate_asset_ids": {"type": "boolean"},
        "locators_all_resolvable": {"type": "boolean"}
      }
    }
  }
}
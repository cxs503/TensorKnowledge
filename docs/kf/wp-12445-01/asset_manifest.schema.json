{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.wp-12445-01.schema.json",
  "title": "asset_manifest.v1 pinned for work package wp-12445-01 (task_type=01-asset-registration)",
  "description": "Package-local pin of the asset manifest shape. The shared schemas/asset_manifest.v1.schema.json in this repo hard-codes consts for wp-448-01 (schema source '/scripts/kf_register_448.py'), so it cannot validate this package; the field names/enums are kept identical and only the package/report consts are re-pinned here. The platform-side schema, if different, wins.",
  "type": "object",
  "required": ["schema", "package_id", "task_type", "report_id", "source", "counts", "assets", "claims", "integrity"],
  "properties": {
    "schema": {"const": "asset_manifest.v1"},
    "package_id": {"const": "wp-12445-01"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"const": "12445"},
    "source": {
      "type": "object",
      "required": ["uri", "field", "hash_alg", "hash", "chars", "bytes_utf8", "title", "scenario_key"],
      "properties": {
        "uri": {"const": "tensor://reports/12445"},
        "field": {"const": "markdown"},
        "hash_alg": {"const": "sha256"},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "chars": {"type": "integer", "minimum": 1},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "platform_title": {"type": ["string", "null"]},
        "title_matches_contract": {"type": "boolean"},
        "scenario_key": {"const": "green_navigation"},
        "platform_scenario_key": {"type": ["string", "null"]},
        "platform_figures": {"type": "array"},
        "platform_tags": {"type": "array"}
      }
    },
    "counts": {
      "type": "object",
      "required": ["assets", "by_class", "by_resolution", "resolved_in_source",
                   "referenced_unresolved", "declared_absent"],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object"},
        "by_resolution": {"type": "object"},
        "resolved_in_source": {"type": "integer", "minimum": 0},
        "referenced_unresolved": {"type": "integer", "minimum": 0},
        "declared_absent": {"type": "integer", "minimum": 0},
        "anchors": {"type": "integer", "minimum": 0}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "asset_class", "label", "in_report_section", "locator",
                     "resolution", "resolution_check", "note"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_class": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "resolution": {"enum": ["resolved_in_source", "referenced_unresolved", "declared_absent"]},
          "resolution_check": {
            "type": "object",
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string", "minLength": 1},
              "result": {"enum": ["resolved", "unresolved", "absent", "present"]}
            }
          },
          "locator": {
            "type": "object",
            "required": ["method", "start_char", "end_char", "start_line", "end_line", "quote", "unique"],
            "properties": {
              "method": {"enum": ["char_span", "document"]},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 1},
              "end_line": {"type": "integer", "minimum": 1},
              "quote": {"type": "string", "minLength": 1},
              "unique": {"const": true}
            }
          },
          "note": {"type": "string"}
        }
      }
    },
    "anchors": {
      "type": "array",
      "description": "Body fields pinned to exact quotes (bookkeeping locators; nothing here is asserted as verified).",
      "items": {
        "type": "object",
        "required": ["anchor_id", "field", "quote", "start_char", "end_char", "start_line", "unique"],
        "properties": {
          "anchor_id": {"type": "string", "minLength": 1},
          "field": {"type": "string", "minLength": 1},
          "quote": {"type": "string", "minLength": 1},
          "start_char": {"type": "integer", "minimum": 0},
          "end_char": {"type": "integer", "minimum": 1},
          "start_line": {"type": "integer", "minimum": 1},
          "unique": {"const": true}
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is the contract-legitimate value for task_type 01 (no extraction, no classification).",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "anyOf": [{"required": ["evidence_locator"]}, {"required": ["status"]}]
      }
    },
    "claims_note": {"type": "string"},
    "integrity": {
      "type": "object",
      "required": ["quote_uniqueness", "hash_recomputed_locally", "hash_matches_contract"],
      "properties": {
        "quote_uniqueness": {"const": true},
        "hash_recomputed_locally": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hash_matches_contract": {"const": true},
        "locator_method": {"type": "string"},
        "no_cross_report_access": {"type": "boolean"}
      }
    }
  }
}
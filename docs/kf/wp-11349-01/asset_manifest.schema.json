{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.v1.wp-11349-01.schema.json",
  "title": "asset_manifest.v1 pinned to package wp-11349-01 (report 11349)",
  "description": "Package-pinned instance of the repo schema schemas/asset_manifest.v1.schema.json (whose consts are hard-wired to wp-448-01, hence not reusable). Shape is identical; consts are tightened to this package and to the contract source_hash so that `schema_pass` is a reproducible check instead of an assertion. Additional properties stay allowed (same as the repo schema) because this manifest carries registration-only extras (kind, provenance, structure_index...). If the platform-side schema is stricter, the platform gate wins.",
  "type": "object",
  "required": ["schema", "package_id", "task_type", "report_id", "source", "counts", "assets", "claims", "integrity"],
  "properties": {
    "schema": {"const": "asset_manifest.v1"},
    "manifest_version": {"type": "string"},
    "package_id": {"const": "wp-11349-01"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"const": "11349"},
    "objective": {
      "type": "object",
      "required": ["register_assets", "classify_report_type"],
      "properties": {
        "register_assets": {"const": true},
        "classify_report_type": {"const": false}
      }
    },
    "source": {
      "type": "object",
      "required": ["uri", "field", "hash_alg", "hash", "chars", "bytes_utf8", "title", "scenario_key"],
      "properties": {
        "uri": {"const": "tensor://reports/11349"},
        "field": {"const": "markdown"},
        "hash_alg": {"const": "sha256"},
        "hash": {"const": "e1dbc9395d11c8d95307584aeb333cc48373b7af373961368e1010642b906e80"},
        "chars": {"const": 1029},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "title": {"const": "P266W1-N10 补记：能力台账 API 接线缺陷修复（capability_audit 路由 404）"},
        "scenario_key": {"const": "platform_governance_capability_ledger_semantics"},
        "platform_figures": {"type": "array"},
        "platform_tags": {"type": "array"}
      }
    },
    "counts": {
      "type": "object",
      "required": ["assets", "by_class", "by_resolution", "resolved_in_source", "referenced_unresolved", "declared_absent"],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object"},
        "by_resolution": {"type": "object"},
        "resolved_in_source": {"type": "integer", "minimum": 0},
        "referenced_unresolved": {"type": "integer", "minimum": 0},
        "declared_absent": {"type": "integer", "minimum": 0},
        "claims": {"type": "integer", "minimum": 0}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "asset_class", "label", "in_report_section", "locator", "resolution", "resolution_check", "note"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_class": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "resolution": {"enum": ["resolved_in_source", "referenced_unresolved", "declared_absent"]},
          "resolution_check": {
            "type": "object",
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string"},
              "result": {"enum": ["resolved", "unresolved", "absent", "present"]}
            }
          },
          "locator": {
            "type": "object",
            "required": ["method", "start_char", "end_char", "start_line", "end_line", "quote", "unique"],
            "properties": {
              "method": {"enum": ["char_span", "document"]},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 0},
              "end_line": {"type": "integer", "minimum": 0},
              "quote": {"type": "string", "minLength": 1},
              "unique": {"type": "boolean"}
            }
          },
          "note": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate for this package (objective.classify_report_type=false, no extraction). Each claim, if any, must carry an evidence locator or an explicit status.",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "anyOf": [{"required": ["evidence_locator"]}, {"required": ["status"]}]
      }
    },
    "integrity": {
      "type": "object",
      "required": ["quote_uniqueness", "hash_recomputed_locally", "hash_matches_contract"],
      "properties": {
        "quote_uniqueness": {"type": "string"},
        "hash_recomputed_locally": {"const": true},
        "hash_matches_contract": {"const": true}
      }
    }
  }
}
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.v1_5776.schema.json",
  "title": "asset_manifest.v1 (KF work package task_type=01-asset-registration) — pinned copy for wp-5776-01",
  "description": "Local, package-scoped schema for docs/kf/wp-5776-01/asset_manifest.json. It mirrors the shape of schemas/asset_manifest.v1.schema.json (wp-448-01) with the consts for report 5776, so acceptance item schema_pass is a reproducible jsonschema.validate call instead of an assertion. The platform-side gate wins if it disagrees.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "package_id", "task_type", "report_id", "provenance", "counts", "assets", "claims", "claims_note", "integrity", "limitations"],
  "properties": {
    "schema": {"const": "asset_manifest.v1"},
    "package_id": {"const": "wp-5776-01"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"const": "5776"},
    "provenance": {
      "type": "object",
      "required": ["source_uri", "source_field", "hash_alg", "source_hash", "chars", "bytes_utf8", "title", "scenario_key", "verification_status"],
      "properties": {
        "source_uri": {"const": "tensor://reports/5776"},
        "source_field": {"const": "markdown"},
        "hash_alg": {"const": "sha256"},
        "source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "chars": {"type": "integer", "minimum": 1},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "scenario_key": {"type": "string", "minLength": 1},
        "verification_status": {"const": "not_verified"},
        "platform_figures": {"type": "array"},
        "platform_tags": {"type": "array"}
      }
    },
    "counts": {
      "type": "object",
      "required": ["assets", "by_class", "by_resolution", "resolved_in_source", "referenced_unresolved", "declared_absent"],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object"},
        "by_resolution": {"type": "object"},
        "resolved_in_source": {"type": "integer", "minimum": 0},
        "referenced_unresolved": {"type": "integer", "minimum": 0},
        "declared_absent": {"type": "integer", "minimum": 0}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "asset_class", "label", "in_report_section", "locator", "resolution", "resolution_check", "note"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_class": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "resolution": {"enum": ["resolved_in_source", "referenced_unresolved", "declared_absent"]},
          "resolution_check": {
            "type": "object",
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string", "minLength": 1},
              "result": {"enum": ["resolved", "unresolved", "absent", "present"]}
            }
          },
          "locator": {
            "type": "object",
            "required": ["method", "start_char", "end_char", "start_line", "end_line", "quote", "unique"],
            "properties": {
              "method": {"enum": ["char_span", "document"]},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 1},
              "end_line": {"type": "integer", "minimum": 1},
              "quote": {"type": "string", "minLength": 1},
              "unique": {"const": true},
              "encoding": {"const": "utf-8"}
            }
          },
          "note": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate for this package. Each claim, if any, must carry evidence or an explicit unresolved status.",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "anyOf": [{"required": ["evidence"]}, {"required": ["status"]}]
      }
    },
    "claims_note": {"type": "string", "minLength": 1},
    "integrity": {
      "type": "object",
      "required": ["quote_uniqueness", "hash_recomputed_locally", "hash_matches_contract", "duplicate_ids"],
      "properties": {
        "hash_recomputed_locally": {"const": true},
        "hash_matches_contract": {"const": true},
        "chars_match_contract": {"const": true},
        "duplicate_ids": {"const": false}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
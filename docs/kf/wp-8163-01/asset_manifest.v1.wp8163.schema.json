{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.v1.schema.json",
  "title": "asset_manifest.v1 retargeted to wp-8163-01 (only the const pins changed)",
  "description": "Derived from schemas/asset_manifest.v1.schema.json, whose package_id/report_id/source.uri are `const`-pinned to wp-448-01. Only those three const values are replaced; every other constraint is the shipped schema's, unchanged. Generated by scripts/kf/kf_wp8163_01_register.py verify.",
  "type": "object",
  "required": [
    "schema",
    "package_id",
    "task_type",
    "report_id",
    "source",
    "counts",
    "assets",
    "claims",
    "integrity"
  ],
  "properties": {
    "schema": {
      "const": "asset_manifest.v1"
    },
    "package_id": {
      "const": "wp-8163-01"
    },
    "task_type": {
      "const": "01-asset-registration"
    },
    "report_id": {
      "const": "8163"
    },
    "source": {
      "type": "object",
      "required": [
        "uri",
        "field",
        "hash_alg",
        "hash",
        "chars",
        "bytes_utf8",
        "title",
        "scenario_key"
      ],
      "properties": {
        "uri": {
          "const": "tensor://reports/8163"
        },
        "field": {
          "const": "markdown"
        },
        "hash_alg": {
          "const": "sha256"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "chars": {
          "type": "integer",
          "minimum": 1
        },
        "bytes_utf8": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scenario_key": {
          "type": "string",
          "minLength": 1
        },
        "platform_figures": {
          "type": "array"
        },
        "platform_tags": {
          "type": "array"
        }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "assets",
        "by_class",
        "by_resolution",
        "resolved_in_source",
        "referenced_unresolved",
        "declared_absent"
      ],
      "properties": {
        "assets": {
          "type": "integer",
          "minimum": 1
        },
        "by_class": {
          "type": "object"
        },
        "by_resolution": {
          "type": "object"
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "asset_class",
          "label",
          "in_report_section",
          "locator",
          "resolution",
          "resolution_check",
          "note"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^A[0-9]{2}$"
          },
          "asset_class": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "in_report_section": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "enum": [
              "resolved_in_source",
              "referenced_unresolved",
              "declared_absent"
            ]
          },
          "resolution_check": {
            "type": "object",
            "required": [
              "check",
              "result"
            ],
            "properties": {
              "check": {
                "type": "string"
              },
              "result": {
                "enum": [
                  "resolved",
                  "unresolved",
                  "absent",
                  "present"
                ]
              }
            }
          },
          "locator": {
            "type": "object",
            "required": [
              "method",
              "start_char",
              "end_char",
              "start_line",
              "end_line",
              "quote",
              "unique"
            ],
            "properties": {
              "method": {
                "enum": [
                  "char_span",
                  "document"
                ]
              },
              "start_char": {
                "type": "integer",
                "minimum": 0
              },
              "end_char": {
                "type": "integer",
                "minimum": 1
              },
              "start_line": {
                "type": "integer",
                "minimum": 0
              },
              "end_line": {
                "type": "integer",
                "minimum": 0
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "unique": {
                "type": "boolean"
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate for this package (objective.classify_report_type=false, no extraction). Each claim, if any, must carry an evidence locator or an explicit status.",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "text"
        ],
        "anyOf": [
          {
            "required": [
              "evidence_locator"
            ]
          },
          {
            "required": [
              "status"
            ]
          }
        ]
      }
    },
    "integrity": {
      "type": "object",
      "required": [
        "quote_uniqueness",
        "hash_recomputed_locally",
        "hash_matches_contract"
      ]
    }
  }
}

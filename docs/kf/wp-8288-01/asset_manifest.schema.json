{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.wp-8288-01.json",
  "title": "asset_manifest.v1 projected onto wp-8288-01 (no const renaming of fields)",
  "description": "Derived from TensorKnowledge schemas/asset_manifest.v1.schema.json (pinned to wp-448-01 via const) by keeping every field/type/enum and replacing only the per-package consts (package_id/report_id/task_type/uri) with the wp-8288-01 values. No other work package's files are modified.",
  "type": "object",
  "required": [
    "schema",
    "package_id",
    "task_type",
    "report_id",
    "source",
    "counts",
    "assets",
    "claims",
    "integrity"
  ],
  "properties": {
    "schema": {
      "const": "asset_manifest.v1"
    },
    "package_id": {
      "const": "wp-8288-01"
    },
    "task_type": {
      "const": "01-asset-registration"
    },
    "report_id": {
      "const": "8288"
    },
    "lane": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "producer": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "uri",
        "field",
        "hash_alg",
        "hash",
        "chars",
        "bytes_utf8",
        "title",
        "scenario_key"
      ],
      "properties": {
        "uri": {
          "const": "tensor://reports/8288"
        },
        "field": {
          "const": "markdown"
        },
        "hash_alg": {
          "const": "sha256"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hash_scope": {
          "type": "string"
        },
        "chars": {
          "type": "integer",
          "minimum": 1
        },
        "bytes_utf8": {
          "type": "integer",
          "minimum": 1
        },
        "lines": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scenario_key": {
          "type": "string",
          "minLength": 1
        },
        "mission_id": {},
        "platform_tags": {
          "type": "array"
        },
        "platform_figures": {
          "type": "array"
        },
        "local_copy": {
          "type": "string"
        }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "assets",
        "by_class",
        "by_resolution",
        "resolved_in_source",
        "referenced_unresolved",
        "declared_absent"
      ],
      "properties": {
        "assets": {
          "type": "integer",
          "minimum": 1
        },
        "by_class": {
          "type": "object"
        },
        "by_resolution": {
          "type": "object"
        },
        "resolved_in_source": {
          "type": "integer",
          "minimum": 0
        },
        "referenced_unresolved": {
          "type": "integer",
          "minimum": 0
        },
        "declared_absent": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "identity_granularity": {
      "type": "string"
    },
    "artifact_endpoint_probe": {
      "type": "object"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "asset_class",
          "label",
          "in_report_section",
          "locator",
          "resolution",
          "resolution_check",
          "note"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^A[0-9]{2}$"
          },
          "asset_class": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "in_report_section": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "enum": [
              "resolved_in_source",
              "referenced_unresolved",
              "declared_absent"
            ]
          },
          "resolution_check": {
            "type": "object",
            "required": [
              "check",
              "result"
            ],
            "properties": {
              "check": {
                "type": "string"
              },
              "result": {
                "enum": [
                  "resolved",
                  "unresolved",
                  "absent",
                  "present"
                ]
              }
            }
          },
          "locator": {
            "type": "object",
            "required": [
              "method",
              "start_char",
              "end_char",
              "start_line",
              "end_line",
              "quote",
              "unique"
            ],
            "properties": {
              "method": {
                "enum": [
                  "char_span",
                  "document"
                ]
              },
              "start_char": {
                "type": "integer",
                "minimum": 0
              },
              "end_char": {
                "type": "integer",
                "minimum": 1
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "unique": {
                "type": "boolean"
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "text"
        ],
        "anyOf": [
          {
            "required": [
              "evidence_locator"
            ]
          },
          {
            "required": [
              "status"
            ]
          }
        ]
      }
    },
    "claims_empty_reason": {
      "type": "string"
    },
    "integrity": {
      "type": "object",
      "required": [
        "quote_uniqueness",
        "hash_recomputed_locally",
        "hash_matches_contract"
      ]
    },
    "limitations": {
      "type": "array"
    }
  }
}

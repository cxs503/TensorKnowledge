{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.v1.wp-7808-01.json",
  "title": "asset_manifest.v1 (KF work package wp-7808-01, task_type=01-asset-registration)",
  "description": "Locally written schema pinning the shape of docs/kf/wp-7808-01/asset_manifest.json so that the acceptance item schema_pass is a reproducible machine check rather than an assertion. It deliberately does not modify the shared schemas/asset_manifest.v1.schema.json (which is pinned to package wp-448-01 by const and belongs to another work package). The authoritative envelope schema is schemas/kf_result.v1.schema.json; if the platform gate uses a different manifest schema, the gate wins and this artifact must be revised.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_version",
    "package_id",
    "task_type",
    "report_id",
    "lane",
    "generated_at",
    "producer",
    "source",
    "counts",
    "assets",
    "claims",
    "claims_empty_reason",
    "id_integrity",
    "coverage",
    "integrity",
    "unresolved",
    "observations",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "asset_manifest.v1"
    },
    "manifest_version": {
      "const": "1.0"
    },
    "package_id": {
      "const": "wp-7808-01"
    },
    "task_type": {
      "const": "01-asset-registration"
    },
    "report_id": {
      "const": "7808"
    },
    "lane": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "generated_at": {
      "type": "string",
      "minLength": 10
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "report_id",
        "source_uri",
        "source_field",
        "source_hash",
        "contract_source_hash",
        "hash_alg",
        "hash_scope",
        "hash_match",
        "chars",
        "contract_chars",
        "chars_match_contract",
        "bytes_utf8",
        "lines",
        "line_counting",
        "fetched_via",
        "record_fields",
        "platform_attachment_probes"
      ],
      "properties": {
        "report_id": {
          "const": "7808"
        },
        "source_uri": {
          "const": "tensor://reports/7808"
        },
        "source_field": {
          "const": "markdown"
        },
        "source_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "contract_source_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "hash_alg": {
          "const": "sha256"
        },
        "hash_scope": {
          "type": "string",
          "minLength": 1
        },
        "hash_match": {
          "const": true
        },
        "chars": {
          "type": "integer",
          "minimum": 1
        },
        "contract_chars": {
          "type": "integer",
          "minimum": 1
        },
        "chars_match_contract": {
          "const": true
        },
        "bytes_utf8": {
          "type": "integer",
          "minimum": 1
        },
        "lines": {
          "type": "integer",
          "minimum": 1
        },
        "line_counting": {
          "type": "string",
          "minLength": 1
        },
        "fetched_via": {
          "type": "string",
          "minLength": 1
        },
        "record_fields": {
          "type": "object",
          "required": [
            "title",
            "scenario_key",
            "figures",
            "tags"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "contract_title": {
              "type": "string",
              "minLength": 1
            },
            "title_matches_contract": {
              "type": "boolean"
            },
            "scenario_key": {
              "type": "string",
              "minLength": 1
            },
            "contract_scenario_key": {
              "type": "string",
              "minLength": 1
            },
            "scenario_matches_contract": {
              "type": "boolean"
            },
            "mission_id": {
              "type": [
                "integer",
                "null"
              ]
            },
            "status": {
              "type": "string"
            },
            "stage": {
              "type": [
                "string",
                "null"
              ]
            },
            "created_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "tags": {
              "type": "array"
            },
            "figures": {
              "type": "array"
            }
          }
        },
        "platform_attachment_probes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "http_status"
            ],
            "properties": {
              "http_status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "assets",
        "by_class",
        "by_resolution",
        "resolved_in_source",
        "referenced_unresolved",
        "declared_absent",
        "figures_declared_in_record",
        "claims"
      ],
      "properties": {
        "assets": {
          "type": "integer",
          "minimum": 1
        },
        "by_class": {
          "type": "object",
          "minProperties": 1
        },
        "by_resolution": {
          "type": "object",
          "minProperties": 1
        },
        "resolved_in_source": {
          "type": "integer",
          "minimum": 0
        },
        "referenced_unresolved": {
          "type": "integer",
          "minimum": 0
        },
        "declared_absent": {
          "type": "integer",
          "minimum": 0
        },
        "figures_declared_in_record": {
          "type": "integer",
          "minimum": 0
        },
        "claims": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "asset_class",
          "label",
          "in_report_section",
          "resolution",
          "resolution_check",
          "locator",
          "note"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^A[0-9]{2}$"
          },
          "asset_class": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "in_report_section": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "enum": [
              "resolved_in_source",
              "referenced_unresolved",
              "declared_absent"
            ]
          },
          "resolution_check": {
            "type": "object",
            "required": [
              "check",
              "result"
            ],
            "properties": {
              "check": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "resolved",
                  "unresolved",
                  "absent",
                  "present"
                ]
              },
              "searched": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "found_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "table_cell_quote": {
                "type": "string"
              }
            }
          },
          "locator": {
            "type": "object",
            "required": [
              "method",
              "start_char",
              "end_char",
              "start_line",
              "end_line",
              "quote",
              "unique",
              "quote_sha256",
              "occurrences_in_source",
              "char_span_roundtrip_ok"
            ],
            "properties": {
              "method": {
                "enum": [
                  "char_span",
                  "document"
                ]
              },
              "start_char": {
                "type": "integer",
                "minimum": 0
              },
              "end_char": {
                "type": "integer",
                "minimum": 1
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "unique": {
                "type": "boolean"
              },
              "end_char_exclusive": {
                "type": "boolean"
              },
              "quote_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "occurrences_in_source": {
                "type": "integer",
                "minimum": 1
              },
              "char_span_roundtrip_ok": {
                "const": true
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is the legitimate complete result for this package (no extraction); any future claim must carry an evidence locator or an explicit unresolved status and must never be marked verified here.",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "text"
        ],
        "anyOf": [
          {
            "required": [
              "evidence_locator"
            ]
          },
          {
            "required": [
              "status"
            ]
          }
        ]
      }
    },
    "claims_empty_reason": {
      "type": "string",
      "minLength": 1
    },
    "id_integrity": {
      "type": "object",
      "required": [
        "ids_checked",
        "duplicates",
        "pattern_ok",
        "unique"
      ],
      "properties": {
        "ids_checked": {
          "type": "integer",
          "minimum": 1
        },
        "duplicates": {
          "type": "array",
          "maxItems": 0
        },
        "pattern_ok": {
          "const": true
        },
        "unique": {
          "const": true
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "path_token_regex",
        "distinct_tokens",
        "tokens",
        "token_to_asset_ids",
        "unmapped_tokens",
        "full_coverage"
      ],
      "properties": {
        "path_token_regex": {
          "type": "string",
          "minLength": 1
        },
        "distinct_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "token_to_asset_ids": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "unmapped_tokens": {
          "type": "array",
          "maxItems": 0
        },
        "full_coverage": {
          "const": true
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": [
        "quote_uniqueness",
        "quote_occurrences",
        "quotes_not_found",
        "quotes_not_unique",
        "hash_recomputed_locally",
        "hash_matches_contract",
        "chars_match_contract",
        "valid_json"
      ],
      "properties": {
        "quote_uniqueness": {
          "type": "string",
          "minLength": 1
        },
        "quote_occurrences": {
          "type": "object",
          "minProperties": 1
        },
        "quotes_not_found": {
          "type": "array"
        },
        "quotes_not_unique": {
          "type": "array"
        },
        "hash_recomputed_locally": {
          "const": true
        },
        "hash_matches_contract": {
          "const": true
        },
        "chars_match_contract": {
          "const": true
        },
        "valid_json": {
          "const": true
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "name",
          "reason"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}

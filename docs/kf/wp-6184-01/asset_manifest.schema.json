{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.v1.json",
  "title": "asset_manifest.v1 (KF work package task_type=01-asset-registration)",
  "description": "Locally pinned shape for the asset manifest emitted by scripts/kf/wp6184_register_assets.py. Package/report identifiers are pattern-constrained rather than const-pinned so one schema serves every 01-asset-registration package; the platform-side kf_result schema wins if it differs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "package_id", "task_type", "report_id", "source", "counts", "assets", "claims", "integrity"],
  "properties": {
    "schema": {"const": "asset_manifest.v1"},
    "package_id": {"type": "string", "pattern": "^wp-[A-Za-z0-9][A-Za-z0-9_.:-]*-[0-9]{2}$"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"type": "string", "pattern": "^[0-9]+$"},
    "source": {
      "type": "object",
      "required": ["uri", "field", "hash_alg", "hash", "chars", "bytes_utf8", "title", "scenario_key"],
      "properties": {
        "uri": {"type": "string", "pattern": "^tensor://reports/[0-9]+$"},
        "field": {"const": "markdown"},
        "hash_alg": {"const": "sha256"},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hash_matches_contract": {"type": "boolean"},
        "chars": {"type": "integer", "minimum": 1},
        "contract_chars": {"type": "integer", "minimum": 1},
        "chars_matches_contract": {"type": "boolean"},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "lines": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "title_matches_contract": {"type": "boolean"},
        "scenario_key": {"type": "string", "minLength": 1},
        "scenario_matches_contract": {"type": "boolean"},
        "record_id": {"type": ["integer", "string", "null"]},
        "record_status": {"type": ["string", "null"]},
        "record_tags": {"type": "array"},
        "platform_figures": {"type": "array"},
        "fetched_via": {"type": "string"},
        "platform_attachment_probes": {"type": "object"},
        "line_counting": {"type": "string"}
      }
    },
    "counts": {
      "type": "object",
      "required": ["assets", "by_class", "by_resolution", "resolved_in_source", "referenced_unresolved", "declared_absent"],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object"},
        "by_resolution": {"type": "object"},
        "resolved_in_source": {"type": "integer", "minimum": 0},
        "referenced_unresolved": {"type": "integer", "minimum": 0},
        "declared_absent": {"type": "integer", "minimum": 0},
        "claims": {"type": "integer", "minimum": 0}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "asset_class", "label", "in_report_section", "locator", "resolution", "resolution_check", "note"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_class": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "resolution": {"enum": ["resolved_in_source", "referenced_unresolved", "declared_absent"]},
          "resolution_check": {
            "type": "object",
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string", "minLength": 1},
              "result": {"enum": ["resolved", "unresolved", "absent", "present"]}
            }
          },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "start_char", "end_char", "start_line", "end_line", "quote", "unique"],
            "properties": {
              "method": {"enum": ["char_span", "document"]},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 1},
              "end_line": {"type": "integer", "minimum": 1},
              "quote": {"type": "string", "minLength": 1},
              "unique": {"type": "boolean"}
            }
          },
          "note": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate for 01-asset-registration (no extraction). Each claim, if any, must carry evidence or an explicit status.",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "anyOf": [{"required": ["evidence_locator"]}, {"required": ["status"]}]
      }
    },
    "integrity": {
      "type": "object",
      "required": ["quote_uniqueness", "hash_recomputed_locally", "hash_matches_contract"],
      "properties": {
        "quote_uniqueness": {"type": "boolean"},
        "hash_recomputed_locally": {"type": "boolean"},
        "hash_matches_contract": {"type": "boolean"},
        "ids_unique": {"type": "boolean"},
        "claims_all_evidenced_or_unresolved": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    }
  }
}
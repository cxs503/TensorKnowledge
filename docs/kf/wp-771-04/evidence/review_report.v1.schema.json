{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "tensor://schemas/review_report.v1.schema.json",
 "title": "review_report.v1 - KF 04-independent-review output",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "package_id",
  "task_type",
  "report_id",
  "reviewed_package",
  "reviewed_package_id",
  "verdict",
  "reviewed_artifacts",
  "reviewer",
  "semantic_fidelity",
  "checks",
  "findings",
  "disposition",
  "verification",
  "checks_not_run",
  "limitations",
  "summary"
 ],
 "properties": {
  "schema": {
   "const": "review_report.v1"
  },
  "package_id": {
   "type": "string",
   "pattern": "^wp-[0-9]+-[0-9]{2}$"
  },
  "task_type": {
   "const": "04-independent-review"
  },
  "report_id": {
   "const": "771"
  },
  "reviewed_package": {
   "type": "string",
   "pattern": "^wp-[0-9]+-[0-9]{2}$"
  },
  "reviewed_package_id": {
   "type": "string",
   "pattern": "^wp-[0-9]+-[0-9]{2}$",
   "description": "field name the platform review gate reads (r2)"
  },
  "verdict": {
   "enum": [
    "pass",
    "needs-fix",
    "fail"
   ],
   "description": "field name the platform review gate reads (r1); equals disposition"
  },
  "reviewed_artifacts": {
   "type": "object",
   "required": [
    "source_hash",
    "upstream_result_report_id",
    "upstream_envelope_sha256"
   ],
   "properties": {
    "source_hash": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_chars": {
     "type": "integer"
    },
    "upstream_result_report_id": {
     "type": "integer"
    },
    "upstream_envelope_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "upstream_result_markdown_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "upstream_output_key": {
     "type": "string"
    }
   },
   "additionalProperties": true
  },
  "reviewer": {
   "type": "object",
   "required": [
    "role",
    "identity",
    "mission_id",
    "independence",
    "context_policy"
   ],
   "properties": {
    "role": {
     "const": "red-team-reviewer"
    },
    "identity": {
     "type": "string",
     "minLength": 3
    },
    "mission_id": {
     "type": "integer"
    },
    "independence": {
     "type": "object",
     "required": [
      "producer_mission_id",
      "reviewer_mission_id",
      "independent"
     ],
     "properties": {
      "producer_mission_id": {
       "type": "integer"
      },
      "reviewer_mission_id": {
       "type": "integer"
      },
      "independent": {
       "type": "boolean"
      }
     },
     "additionalProperties": true
    },
    "context_policy": {
     "type": "string",
     "minLength": 1
    },
    "review_prompt_origin": {
     "type": "string"
    }
   },
   "additionalProperties": true
  },
  "semantic_fidelity": {
   "type": "object",
   "required": [
    "applicable_scope",
    "judgement",
    "basis"
   ],
   "properties": {
    "applicable_scope": {
     "type": "string"
    },
    "judgement": {
     "enum": [
      "faithful",
      "overstated",
      "understated",
      "unsupported",
      "not_applicable"
     ]
    },
    "basis": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1
    }
   },
   "additionalProperties": true
  },
  "checks": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "result",
     "blocking",
     "detail"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "result": {
      "enum": [
       "pass",
       "fail",
       "not_run"
      ]
     },
     "blocking": {
      "type": "boolean"
     },
     "maps_to_upstream_acceptance": {
      "type": [
       "string",
       "null"
      ]
     },
     "detail": {
      "type": "string"
     },
     "evidence": {
      "type": "object"
     }
    },
    "additionalProperties": true
   }
  },
  "findings": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "severity",
     "blocking",
     "scope",
     "statement",
     "evidence",
     "remediation"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "severity": {
      "enum": [
       "critical",
       "high",
       "medium",
       "low",
       "info"
      ]
     },
     "blocking": {
      "type": "boolean"
     },
     "scope": {
      "type": "string"
     },
     "statement": {
      "type": "string"
     },
     "evidence": {
      "type": "string"
     },
     "remediation": {
      "type": "string"
     }
    },
    "additionalProperties": true
   }
  },
  "disposition": {
   "enum": [
    "pass",
    "needs-fix",
    "fail"
   ]
  },
  "verification": {
   "type": "object",
   "required": [
    "self_marked_verified",
    "note"
   ],
   "properties": {
    "self_marked_verified": {
     "const": false
    },
    "note": {
     "type": "string"
    }
   },
   "additionalProperties": true
  },
  "checks_not_run": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "limitations": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "summary": {
   "type": "object",
   "required": [
    "checks_total",
    "checks_pass",
    "checks_fail",
    "findings_total",
    "findings_blocking",
    "upstream_acceptance_recomputed"
   ],
   "properties": {
    "checks_total": {
     "type": "integer"
    },
    "checks_pass": {
     "type": "integer"
    },
    "checks_fail": {
     "type": "integer"
    },
    "findings_total": {
     "type": "integer"
    },
    "findings_blocking": {
     "type": "integer"
    },
    "upstream_acceptance_recomputed": {
     "type": "object"
    }
   },
   "additionalProperties": true
  }
 }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.v1.wp-9645-01.schema.json",
  "title": "asset_manifest.v1 instantiated for KF work package wp-9645-01",
  "description": "Derived from schemas/asset_manifest.v1.schema.json (never edited): only the pinned identity consts and the additive blocks introduced by this package (outline, tables, number_audit) differ. Field names and enums of the shared contract are unchanged, so a manifest valid here is valid against the shared shape except for the identity consts.",
  "type": "object",
  "required": [
    "assets",
    "claims",
    "counts",
    "integrity",
    "number_audit",
    "outline",
    "package_id",
    "report_id",
    "schema",
    "source",
    "tables",
    "task_type"
  ],
  "properties": {
    "schema": {
      "const": "asset_manifest.v1"
    },
    "package_id": {
      "const": "wp-9645-01"
    },
    "task_type": {
      "const": "01-asset-registration"
    },
    "report_id": {
      "const": "9645"
    },
    "source": {
      "type": "object",
      "required": [
        "uri",
        "field",
        "hash_alg",
        "hash",
        "chars",
        "bytes_utf8",
        "title",
        "scenario_key"
      ],
      "properties": {
        "uri": {
          "const": "tensor://reports/9645"
        },
        "field": {
          "const": "markdown"
        },
        "hash_alg": {
          "const": "sha256"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "chars": {
          "type": "integer",
          "minimum": 1
        },
        "bytes_utf8": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scenario_key": {
          "type": "string",
          "minLength": 1
        },
        "platform_figures": {
          "type": "array"
        },
        "platform_tags": {
          "type": "array"
        },
        "contract_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "contract_chars": {
          "type": "integer",
          "minimum": 1
        },
        "hash_matches_contract": {
          "type": "boolean"
        },
        "chars_matches_contract": {
          "type": "boolean"
        },
        "title_matches_contract": {
          "type": "boolean"
        },
        "scenario_matches_contract": {
          "type": "boolean"
        },
        "platform_record": {
          "type": "object"
        }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "assets",
        "by_class",
        "by_resolution",
        "resolved_in_source",
        "referenced_unresolved",
        "declared_absent"
      ],
      "properties": {
        "assets": {
          "type": "integer",
          "minimum": 1
        },
        "by_class": {
          "type": "object"
        },
        "by_resolution": {
          "type": "object"
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "asset_class",
          "label",
          "in_report_section",
          "locator",
          "resolution",
          "resolution_check",
          "note"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^A[0-9]{2}$"
          },
          "asset_class": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "in_report_section": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "enum": [
              "resolved_in_source",
              "referenced_unresolved",
              "declared_absent"
            ]
          },
          "resolution_check": {
            "type": "object",
            "required": [
              "check",
              "result"
            ],
            "properties": {
              "check": {
                "type": "string"
              },
              "result": {
                "enum": [
                  "resolved",
                  "unresolved",
                  "absent",
                  "present"
                ]
              }
            }
          },
          "locator": {
            "type": "object",
            "required": [
              "method",
              "start_char",
              "end_char",
              "start_line",
              "end_line",
              "quote",
              "unique"
            ],
            "properties": {
              "method": {
                "enum": [
                  "char_span",
                  "document"
                ]
              },
              "start_char": {
                "type": "integer",
                "minimum": 0
              },
              "end_char": {
                "type": "integer",
                "minimum": 1
              },
              "start_line": {
                "type": "integer",
                "minimum": 0
              },
              "end_line": {
                "type": "integer",
                "minimum": 0
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "unique": {
                "type": "boolean"
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate for this package (objective.classify_report_type=false, no extraction). Each claim, if any, must carry an evidence locator or an explicit status.",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "text"
        ],
        "anyOf": [
          {
            "required": [
              "evidence_locator"
            ]
          },
          {
            "required": [
              "status"
            ]
          }
        ]
      }
    },
    "integrity": {
      "type": "object",
      "required": [
        "quote_uniqueness",
        "hash_recomputed_locally",
        "hash_matches_contract"
      ]
    },
    "outline": {
      "type": "object",
      "required": [
        "sections"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1
        },
        "chars": {
          "type": "integer"
        },
        "lines": {
          "type": "integer"
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "table_id",
          "header",
          "start_line",
          "end_line",
          "locator"
        ],
        "properties": {
          "table_id": {
            "type": "string",
            "pattern": "^T[0-9]{2}$"
          },
          "semantic": {
            "type": "string"
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "n_rows": {
            "type": "integer",
            "minimum": 0
          },
          "locator": {
            "type": "object",
            "required": [
              "method",
              "start_char",
              "end_char",
              "start_line",
              "end_line",
              "quote",
              "unique"
            ],
            "properties": {
              "method": {
                "enum": [
                  "char_span",
                  "document"
                ]
              },
              "start_char": {
                "type": "integer",
                "minimum": 0
              },
              "end_char": {
                "type": "integer",
                "minimum": 1
              },
              "start_line": {
                "type": "integer",
                "minimum": 0
              },
              "end_line": {
                "type": "integer",
                "minimum": 0
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "unique": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "number_audit": {
      "type": "object",
      "required": [
        "checks",
        "not_audited",
        "summary"
      ],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "check_id",
              "family",
              "quantity",
              "declared",
              "recomputed",
              "error",
              "tolerance",
              "verdict"
            ],
            "properties": {
              "verdict": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              },
              "error_kind": {
                "enum": [
                  "relative",
                  "absolute"
                ]
              }
            }
          }
        },
        "families": {
          "type": "object"
        },
        "not_audited": {
          "type": "array"
        },
        "summary": {
          "type": "object",
          "required": [
            "checks",
            "passed",
            "failed",
            "all_passed"
          ]
        }
      }
    }
  }
}

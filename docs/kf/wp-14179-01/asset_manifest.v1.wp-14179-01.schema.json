{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.v1.wp-14179-01.schema.json",
  "title": "asset_manifest.v1 pinned for KF work package wp-14179-01 (task_type=01-asset-registration)",
  "description": "Locally pinned schema for the asset_manifest.json emitted by scripts/kf_wp14179_01_register.py. It pins the shape actually used so that acceptance item schema_pass is a reproducible machine check (scripts/kf_wp14179_01_verify.py) rather than an assertion. The platform-side envelope schema (schemas/kf_result.v1.schema.json) validates the surrounding result envelope; if the platform gate uses a stricter manifest schema, the platform gate wins and this artifact must be revised.",
  "type": "object",
  "required": [
    "schema",
    "package_id",
    "task_type",
    "contract_version",
    "report_id",
    "generator",
    "source",
    "counts",
    "assets",
    "claims",
    "boundary"
  ],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "const": "asset_manifest.v1"
    },
    "package_id": {
      "const": "wp-14179-01"
    },
    "task_type": {
      "const": "01-asset-registration"
    },
    "contract_version": {
      "const": "1.0"
    },
    "report_id": {
      "const": "14179"
    },
    "lane": {
      "type": "string"
    },
    "generator": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "uri",
        "field",
        "hash_alg",
        "hash",
        "hash_expected",
        "hash_matches_contract",
        "chars",
        "chars_expected",
        "chars_matches",
        "bytes_utf8",
        "title",
        "scenario_key",
        "retrieved_via"
      ],
      "additionalProperties": true,
      "properties": {
        "uri": {
          "const": "tensor://reports/14179"
        },
        "field": {
          "const": "markdown"
        },
        "hash_alg": {
          "const": "sha256"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hash_expected": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hash_matches_contract": {
          "const": true
        },
        "chars": {
          "type": "integer",
          "minimum": 1
        },
        "chars_expected": {
          "type": "integer",
          "minimum": 1
        },
        "chars_matches": {
          "const": true
        },
        "bytes_utf8": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scenario_key": {
          "type": "string",
          "minLength": 1
        },
        "platform_figures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retrieved_via": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "assets",
        "by_class",
        "by_resolution",
        "resolved_in_source",
        "referenced_unresolved",
        "declared_absent"
      ],
      "properties": {
        "assets": {
          "type": "integer",
          "minimum": 1
        },
        "by_class": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "by_resolution": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "resolved_in_source": {
          "type": "integer",
          "minimum": 0
        },
        "referenced_unresolved": {
          "type": "integer",
          "minimum": 0
        },
        "declared_absent": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "asset_class",
          "label",
          "in_report_section",
          "locator",
          "resolution",
          "resolution_check",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^A[0-9]{2}$"
          },
          "asset_class": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "in_report_section": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "enum": [
              "resolved_in_source",
              "referenced_unresolved",
              "declared_absent"
            ]
          },
          "resolution_check": {
            "type": "object",
            "required": [
              "check",
              "result"
            ],
            "properties": {
              "check": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "resolved",
                  "unresolved",
                  "absent",
                  "present"
                ]
              }
            },
            "additionalProperties": true
          },
          "locator": {
            "type": "object",
            "required": [
              "method",
              "start_char",
              "end_char",
              "start_line",
              "end_line",
              "quote",
              "unique",
              "occurrences"
            ],
            "additionalProperties": false,
            "properties": {
              "method": {
                "enum": [
                  "char_span",
                  "document"
                ]
              },
              "start_char": {
                "type": "integer",
                "minimum": 0
              },
              "end_char": {
                "type": "integer",
                "minimum": 1
              },
              "start_line": {
                "type": "integer",
                "minimum": 0
              },
              "end_line": {
                "type": "integer",
                "minimum": 0
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "unique": {
                "const": true
              },
              "occurrences": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is a legitimate complete result for this package: objective.classify_report_type=false and no extraction is performed, so no claim is invented to fill a metric.",
      "maxItems": 0
    },
    "claims_note": {
      "type": "string",
      "minLength": 1
    },
    "boundary": {
      "type": "object",
      "required": [
        "only_report_id",
        "read_other_reports",
        "marked_verified",
        "extraction_done",
        "classification_done"
      ],
      "additionalProperties": true,
      "properties": {
        "only_report_id": {
          "const": "14179"
        },
        "read_other_reports": {
          "const": false
        },
        "marked_verified": {
          "const": false
        },
        "extraction_done": {
          "const": false
        },
        "classification_done": {
          "const": false
        }
      }
    },
    "blocks": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "pipe_tables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "anchor_asset",
              "header_cells",
              "data_rows",
              "start_line",
              "registered_as"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "anchor_asset": {
                "type": "string",
                "pattern": "^A[0-9]{2}$"
              },
              "header_cells": {
                "type": "integer",
                "minimum": 1
              },
              "data_rows": {
                "type": "integer",
                "minimum": 0
              },
              "start_line": {
                "type": "integer",
                "minimum": 0
              },
              "registered_as": {
                "const": "structure_only"
              }
            },
            "additionalProperties": false
          }
        },
        "fenced_code_blocks_none": {
          "type": "boolean"
        }
      }
    }
  }
}

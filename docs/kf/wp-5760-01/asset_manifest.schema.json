{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.wp-5760-01.schema.json",
  "title": "asset_manifest (KF work package wp-5760-01, task_type=01-asset-registration)",
  "description": "Package-scoped schema used as the machine-checkable target for the schema_pass acceptance item. Structure follows schemas/asset_manifest.v1.schema.json (the only asset_manifest schema shipped in this worktree, hard-wired to wp-448-01) with the const package/report ids generalised to this package and the report_field locator method added for platform-side (non-markdown) metadata. The canonical schemas/kf_result.v1.schema.json referenced by the work-package contract is NOT present in this worktree; if the platform-side shape differs, the platform gate wins and this artifact must be revised.",
  "type": "object",
  "required": ["schema", "package_id", "task_type", "report_id", "source", "counts", "assets", "claims", "integrity"],
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "asset_manifest.v1"},
    "package_id": {"const": "wp-5760-01"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"type": "string", "pattern": "^5760$"},
    "generator": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["uri", "field", "hash_alg", "hash", "chars", "bytes_utf8", "title", "scenario_key"],
      "additionalProperties": true,
      "properties": {
        "uri": {"const": "tensor://reports/5760"},
        "field": {"const": "markdown"},
        "hash_alg": {"const": "sha256"},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "chars": {"type": "integer", "minimum": 1},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "scenario_key": {"type": "string", "minLength": 1},
        "platform_figures": {"type": "array"},
        "platform_tags": {"type": "array"},
        "mission_id": {"type": ["integer", "null"]},
        "report_status": {"type": ["string", "null"]},
        "report_created_at": {"type": ["string", "null"]}
      }
    },
    "counts": {
      "type": "object",
      "required": ["assets", "by_class", "by_resolution", "resolved_in_source", "referenced_unresolved", "declared_absent"],
      "additionalProperties": true,
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "by_resolution": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "resolved_in_source": {"type": "integer", "minimum": 0},
        "referenced_unresolved": {"type": "integer", "minimum": 0},
        "declared_absent": {"type": "integer", "minimum": 0}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "asset_class", "label", "in_report_section", "locator", "resolution", "resolution_check", "note"],
        "additionalProperties": true,
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_class": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "resolution": {"enum": ["resolved_in_source", "referenced_unresolved", "declared_absent"]},
          "resolution_check": {
            "type": "object",
            "required": ["check", "result"],
            "additionalProperties": true,
            "properties": {
              "check": {"type": "string", "minLength": 1},
              "result": {"enum": ["resolved", "unresolved", "absent", "present"]}
            }
          },
          "locator": {
            "type": "object",
            "required": ["method", "quote"],
            "additionalProperties": true,
            "properties": {
              "method": {"enum": ["char_span", "document", "report_field"]},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 1},
              "end_line": {"type": "integer", "minimum": 1},
              "field": {"type": "string", "minLength": 1},
              "index": {"type": "integer", "minimum": 0},
              "quote": {"type": "string", "minLength": 1},
              "unique": {"type": "boolean"}
            }
          },
          "note": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate for this package (objective.classify_report_type=false, notes: '不做抽取'). Each claim, if any, must carry an evidence locator or an explicit status.",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "anyOf": [{"required": ["evidence_locator"]}, {"required": ["status"]}]
      }
    },
    "integrity": {
      "type": "object",
      "required": ["quote_uniqueness", "hash_recomputed_locally", "hash_matches_contract", "no_duplicate_ids", "char_span_exact"],
      "additionalProperties": true
    }
  }
}
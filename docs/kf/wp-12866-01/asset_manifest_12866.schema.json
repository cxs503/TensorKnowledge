{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/asset_manifest_12866.v1.schema.json",
  "title": "asset_manifest.v1 (package wp-12866-01, task_type=01-asset-registration)",
  "description": "Locally pinned shape of docs/kf/wp-12866-01/asset_manifest.json, so that the acceptance item schema_pass is a reproducible check. The platform-side gate wins if it enforces a different shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_version",
    "package_id",
    "task_type",
    "report_id",
    "contract_version",
    "objective",
    "source",
    "structure_index",
    "resolution_vocabulary",
    "assets",
    "counts",
    "claims",
    "integrity",
    "producer",
    "repro_cmd"
  ],
  "properties": {
    "schema": {"const": "asset_manifest.v1"},
    "manifest_version": {"const": "1.0"},
    "package_id": {"const": "wp-12866-01"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"const": "12866"},
    "contract_version": {"const": "1.0"},
    "objective": {
      "type": "object",
      "required": ["register_assets", "classify_report_type"],
      "properties": {
        "register_assets": {"const": true},
        "classify_report_type": {"const": false}
      }
    },
    "generated_at": {"type": "string"},
    "source": {
      "type": "object",
      "required": [
        "uri",
        "field",
        "hash_alg",
        "hash",
        "contract_hash",
        "hash_matches_contract",
        "chars",
        "bytes_utf8",
        "title",
        "scenario_key"
      ],
      "properties": {
        "uri": {"const": "tensor://reports/12866"},
        "field": {"const": "markdown"},
        "hash_alg": {"const": "sha256"},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hash_matches_contract": {"const": true},
        "hash_scope": {"type": "string"},
        "chars": {"type": "integer", "minimum": 1},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "scenario_key": {"type": "string", "minLength": 1},
        "mission_id": {"type": ["integer", "null"]},
        "status": {"type": ["string", "null"]},
        "tags": {"type": "array"},
        "platform_figures": {"type": "object"},
        "fetched_via": {"type": "string"}
      }
    },
    "structure_index": {
      "type": "object",
      "required": ["note", "headings"],
      "properties": {
        "note": {"type": "string"},
        "headings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["level", "text", "line_no", "start_char"],
            "properties": {
              "level": {"type": "integer", "minimum": 1, "maximum": 3},
              "text": {"type": "string", "minLength": 1},
              "line_no": {"type": "integer", "minimum": 1},
              "start_char": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "resolution_vocabulary": {"type": "object", "minProperties": 1},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "asset_class",
          "label",
          "in_report_section",
          "locator",
          "resolution",
          "resolution_check",
          "note"
        ],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_class": {
            "enum": [
              "report_markdown",
              "embedded_figure",
              "source_code_reference",
              "test_reference",
              "report_document",
              "artifact_directory",
              "artifact_file_reference",
              "platform_identifier",
              "vcs_reference",
              "repository_reference"
            ]
          },
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "locator": {
            "type": "object",
            "required": ["method", "start_char", "end_char", "start_line", "end_line", "quote", "unique"],
            "properties": {
              "method": {"const": "char_span"},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 1},
              "end_line": {"type": "integer", "minimum": 1},
              "quote": {"type": "string", "minLength": 1},
              "unique": {"type": "boolean"}
            }
          },
          "resolution": {"enum": ["resolved_in_source", "referenced_unresolved", "declared_absent"]},
          "resolution_check": {
            "type": "object",
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string", "minLength": 1},
              "result": {"enum": ["resolved", "unresolved", "absent", "present"]}
            }
          },
          "payload": {
            "type": "object",
            "required": ["record_figure_name", "probe", "local_copy"],
            "properties": {
              "record_figure_name": {"type": "string", "minLength": 1},
              "probe": {
                "type": "object",
                "required": ["endpoint", "http_status", "bytes", "sha256", "resolvable"],
                "properties": {
                  "endpoint": {"type": "string", "minLength": 1},
                  "http_status": {"type": "integer"},
                  "bytes": {"type": "integer", "minimum": 1},
                  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "resolvable": {"const": true}
                }
              },
              "local_copy": {"type": "string", "minLength": 1}
            }
          },
          "record_cross_check": {"type": "object"},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["assets", "by_class", "by_resolution", "resolved_in_source", "referenced_unresolved", "declared_absent"],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object"},
        "by_resolution": {"type": "object"},
        "resolved_in_source": {"type": "integer", "minimum": 0},
        "referenced_unresolved": {"type": "integer", "minimum": 0},
        "declared_absent": {"type": "integer", "minimum": 0},
        "claims_registered": {"const": 0}
      }
    },
    "nonextraction_note": {"type": "string"},
    "claims": {
      "type": "array",
      "maxItems": 0,
      "description": "task_type 01 performs no extraction; the empty array is the contract-permitted complete result."
    },
    "claims_note": {"type": "string"},
    "integrity": {
      "type": "object",
      "required": [
        "quote_uniqueness",
        "hash_recomputed_locally",
        "hash_matches_contract",
        "asset_ids_unique",
        "single_report_scope"
      ],
      "properties": {
        "quote_uniqueness": {"const": true},
        "hash_recomputed_locally": {"const": true},
        "hash_matches_contract": {"const": true},
        "asset_ids_unique": {"const": true},
        "single_report_scope": {"const": true}
      }
    },
    "producer": {"type": "string", "minLength": 1},
    "repro_cmd": {"type": "string", "minLength": 1},
    "tools": {"type": "object"}
  }
}
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.v1.wp-7216-01.json",
  "title": "asset_manifest.v1 as used by package wp-7216-01 (task_type=01-asset-registration)",
  "description": "Structural pin for the asset_manifest.json produced by scripts/kf_wp721601_register_assets.py. Derived from schemas/asset_manifest.v1.schema.json (the wp-448 precedent) with its package-level consts re-parameterised to this package (package_id/report_id/source uri), because that file hard-codes wp-448-01/448 and therefore cannot validate any other package. Where the platform-side schema differs, the platform gate wins and this artifact must be revised. Validation: jsonschema Draft7Validator, run by `verify`.",
  "type": "object",
  "required": [
    "schema",
    "manifest_version",
    "package_id",
    "task_type",
    "report_id",
    "source",
    "counts",
    "assets",
    "claims",
    "claims_empty_reason",
    "integrity"
  ],
  "properties": {
    "schema": {"const": "asset_manifest.v1"},
    "manifest_version": {"const": "1.0"},
    "package_id": {"const": "wp-7216-01"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"const": "7216"},
    "lane": {"const": "C"},
    "producer": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["report_id", "source_uri", "source_field", "hash_alg", "hash", "source_hash",
                   "contract_source_hash", "hash_match", "chars", "contract_chars",
                   "chars_match_contract", "bytes_utf8", "lines", "title", "scenario_key",
                   "title_matches_contract", "scenario_matches_contract", "platform_figures"],
      "properties": {
        "report_id": {"const": "7216"},
        "source_uri": {"const": "tensor://reports/7216"},
        "source_field": {"const": "markdown"},
        "hash_alg": {"const": "sha256"},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "contract_source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "hash_match": {"const": true},
        "chars": {"type": "integer", "minimum": 1},
        "contract_chars": {"type": "integer", "minimum": 1},
        "chars_match_contract": {"const": true},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "lines": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "scenario_key": {"type": "string", "minLength": 1},
        "title_matches_contract": {"const": true},
        "scenario_matches_contract": {"const": true},
        "platform_figures": {"type": "array"}
      }
    },
    "counts": {
      "type": "object",
      "required": ["assets", "by_class", "by_resolution", "resolved_in_source",
                   "referenced_unresolved", "declared_absent"],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object"},
        "by_resolution": {"type": "object"},
        "resolved_in_source": {"type": "integer", "minimum": 0},
        "referenced_unresolved": {"type": "integer", "minimum": 0},
        "declared_absent": {"type": "integer", "minimum": 0}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "asset_key", "asset_class", "label", "in_report_section",
                     "locator", "resolution", "resolution_check", "note"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_key": {"type": "string", "minLength": 3},
          "asset_class": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "resolution": {"enum": ["resolved_in_source", "referenced_unresolved", "declared_absent"]},
          "resolution_check": {
            "type": "object",
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string", "minLength": 1},
              "result": {"enum": ["resolved", "unresolved", "absent", "present"]}
            }
          },
          "locator": {
            "type": "object",
            "required": ["method", "source_field", "char_start", "char_end", "line_start",
                         "line_end", "quote", "quote_sha256", "unique"],
            "properties": {
              "method": {"enum": ["char_span", "document"]},
              "source_field": {"const": "markdown"},
              "char_start": {"type": "integer", "minimum": 0},
              "char_end": {"type": "integer", "minimum": 1},
              "line_start": {"type": "integer", "minimum": 1},
              "line_end": {"type": "integer", "minimum": 1},
              "quote": {"type": "string", "minLength": 1},
              "quote_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "unique": {"type": "boolean"}
            }
          },
          "occurrence_lines": {"type": "array", "items": {"type": "integer", "minimum": 1}},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate for this package (objective.classify_report_type=false, registration only). Each claim, if any, must carry an evidence locator or an explicit status.",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "anyOf": [{"required": ["evidence"]}, {"required": ["status"]}]
      }
    },
    "claims_empty_reason": {"type": "string", "minLength": 1},
    "integrity": {
      "type": "object",
      "required": ["quote_uniqueness", "hash_recomputed_locally", "hash_matches_contract",
                   "assets_with_locator", "verified_marks_emitted"],
      "properties": {
        "hash_recomputed_locally": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "hash_matches_contract": {"const": true},
        "assets_with_locator": {"type": "integer", "minimum": 1},
        "assets_without_locator": {"type": "integer", "minimum": 0},
        "verified_marks_emitted": {"const": 0}
      }
    }
  }
}
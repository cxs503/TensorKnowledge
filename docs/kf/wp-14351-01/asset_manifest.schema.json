{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.wp-14351-01.schema.json",
  "title": "asset_manifest (KF work package wp-14351-01, task_type=01-asset-registration)",
  "description": "Locally pinned shape of docs/kf/wp-14351-01/asset_manifest.json, derived from schemas/asset_manifest.v1.schema.json (which hard-codes the wp-448-01 constants) with the wp-14351-01 constants substituted. Pinning it locally makes acceptance item schema_pass a reproducible machine check instead of an assertion. If a platform-side canonical schema exists, the platform gate wins and this artifact must be revised.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "package_id",
    "task_type",
    "report_id",
    "lane",
    "objective",
    "generated_at",
    "generator",
    "generator_inputs",
    "source",
    "attachment_scan",
    "assets",
    "counts",
    "claims",
    "claim_policy",
    "integrity",
    "limitations"
  ],
  "properties": {
    "manifest_version": {"const": "1.0"},
    "package_id": {"const": "wp-14351-01"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"const": "14351"},
    "lane": {"const": "B"},
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["register_assets", "classify_report_type", "extraction_performed"],
      "properties": {
        "register_assets": {"const": true},
        "classify_report_type": {"const": false},
        "extraction_performed": {"const": false}
      }
    },
    "generated_at": {"type": "string"},
    "generator": {"type": "string"},
    "generator_inputs": {
      "type": "object",
      "required": [
        "report_id",
        "source_uri",
        "source_field",
        "contract_expected_sha256",
        "contract_expected_chars"
      ],
      "properties": {
        "report_id": {"const": "14351"},
        "source_uri": {"const": "tensor://reports/14351"},
        "source_field": {"const": "markdown"},
        "contract_expected_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "contract_expected_chars": {"type": "integer", "minimum": 1},
        "retrieval_endpoint": {"type": "string"}
      }
    },
    "source": {
      "type": "object",
      "required": [
        "report_id",
        "source_uri",
        "source_field",
        "sha256",
        "contract_declared_sha256",
        "source_hash_matches",
        "chars",
        "bytes_utf8",
        "lines",
        "contract_declared_chars",
        "chars_match",
        "hash_scope",
        "record",
        "sections"
      ],
      "properties": {
        "report_id": {"const": "14351"},
        "source_uri": {"const": "tensor://reports/14351"},
        "source_field": {"const": "markdown"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "contract_declared_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_hash_matches": {"const": true},
        "chars": {"type": "integer", "minimum": 1},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "lines": {"type": "integer", "minimum": 1},
        "contract_declared_chars": {"type": "integer", "minimum": 1},
        "chars_match": {"const": true},
        "hash_scope": {"type": "string"},
        "record": {
          "type": "object",
          "required": ["id", "title", "scenario_key", "tags", "status"],
          "properties": {
            "id": {"const": 14351},
            "title": {"type": "string", "minLength": 1},
            "scenario_key": {"type": "string", "minLength": 1},
            "mission_id": {"type": ["integer", "null"]},
            "status": {"type": "string"},
            "created_at": {"type": "string"},
            "tags": {"type": "array"},
            "summary_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "summary_chars": {"type": "integer"}
          }
        },
        "sections": {"type": "array", "minItems": 1}
      }
    },
    "attachment_scan": {"type": "object"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "asset_class",
          "label",
          "in_report_section",
          "locator",
          "resolution",
          "resolution_check",
          "note"
        ],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_class": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "locator": {
            "type": "object",
            "required": [
              "method",
              "start_char",
              "end_char",
              "start_line",
              "end_line",
              "quote",
              "quote_sha256",
              "quote_unique",
              "matches_source"
            ],
            "properties": {
              "method": {"enum": ["char_span", "document"]},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 0},
              "end_line": {"type": "integer", "minimum": 0},
              "quote": {"type": "string", "minLength": 1},
              "quote_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "quote_unique": {"type": "boolean"},
              "matches_source": {"const": true}
            }
          },
          "resolution": {
            "enum": ["resolved_in_source", "referenced_unresolved", "declared_absent"]
          },
          "resolution_check": {
            "type": "object",
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string", "minLength": 1},
              "result": {"enum": ["resolved", "unresolved", "absent", "present"]},
              "detail": {"type": "string"}
            }
          },
          "note": {"type": "string"}
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["assets", "by_class", "by_resolution"],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object"},
        "by_resolution": {
          "type": "object",
          "required": ["resolved_in_source", "referenced_unresolved", "declared_absent"],
          "properties": {
            "resolved_in_source": {"type": "integer", "minimum": 0},
            "referenced_unresolved": {"type": "integer", "minimum": 0},
            "declared_absent": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty array is the contract-legitimate value here (objective.classify_report_type=false, no extraction).",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "anyOf": [{"required": ["evidence"]}, {"required": ["status"]}]
      }
    },
    "claim_policy": {"type": "object"},
    "integrity": {
      "type": "object",
      "required": [
        "quote_uniqueness",
        "hash_recomputed_locally",
        "hash_matches_contract",
        "no_duplicate_ids",
        "all_locators_resolvable",
        "claims_marked_verified"
      ],
      "properties": {
        "quote_uniqueness": {"const": true},
        "hash_recomputed_locally": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "hash_matches_contract": {"const": true},
        "no_duplicate_ids": {"const": true},
        "all_locators_resolvable": {"const": true},
        "claims_marked_verified": {"const": 0}
      }
    },
    "limitations": {"type": "array", "minItems": 1}
  }
}
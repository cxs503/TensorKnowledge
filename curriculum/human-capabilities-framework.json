{
  "id": "tk:framework:human-capabilities-ai-era",
  "title": "Human Capabilities in the AI Era",
  "version": "0.1.0",
  "status": "draft",
  "purpose": "Define cross-cutting human capabilities that guide TensorKnowledge curriculum design, learning pathways, tutorials, and assessment.",
  "layers": [
    {"id": "understanding", "title": "Foundations for Understanding", "capabilities": ["observation", "language-and-conceptualization", "quantitative-and-formal-reasoning", "evidence-and-epistemic-judgment", "mental-modeling"]},
    {"id": "inquiry", "title": "Inquiry and Transformation", "capabilities": ["problem-framing", "causal-and-experimental-reasoning", "systems-and-interdisciplinary-thinking", "design-and-making", "creativity-and-discovery"]},
    {"id": "agency", "title": "Agency in a World of Agents", "capabilities": ["ai-and-tool-fluency", "delegation-and-orchestration", "critical-evaluation-and-verification", "learning-agility", "collaborative-communication"]},
    {"id": "responsibility", "title": "Responsibility, Meaning, and Civilization", "capabilities": ["ethical-and-civic-judgment", "responsibility-and-accountability", "self-direction-and-purpose", "care-and-relationship", "long-horizon-and-civilizational-thinking"]}
  ],
  "learning_dimensions": ["know", "do", "be-responsible-for"],
  "progression": ["orient", "explain", "apply", "evaluate", "transfer", "create", "steward"],
  "review": {
    "domain_expert_review": "not-started",
    "education_research_review": "not-started",
    "learner_pilot": "not-started",
    "accessibility_and_inclusion_review": "not-started"
  },
  "notes": [
    "Layers are mutually reinforcing and are not a rigid sequence.",
    "Capabilities are not claims about tasks that machines can never perform.",
    "Assessment must distinguish learner understanding from agent-produced output."
  ]
}
{
  "id": "tk:learning-cycle:ai-era",
  "version": "0.1.0",
  "status": "draft",
  "title": "Learning and capability development cycle",
  "description": "A revisable, evidence-oriented cycle for entering unfamiliar fields, developing capability, exercising judgment, transferring learning, creating, and contributing.",
  "stages": [
    {
      "id": "orient",
      "order": 1,
      "goal": "Establish a meaningful purpose and context.",
      "actions": [
        "state learner goal",
        "identify stakeholders and constraints",
        "explain why the question matters"
      ],
      "evidence": [
        "goal statement",
        "context and constraint map"
      ]
    },
    {
      "id": "diagnose",
      "order": 2,
      "goal": "Make prior knowledge and uncertainty visible.",
      "actions": [
        "elicit prior understanding",
        "identify misconceptions and gaps",
        "record resource and accessibility needs"
      ],
      "evidence": [
        "baseline explanation or task",
        "uncertainty log"
      ]
    },
    {
      "id": "map",
      "order": 3,
      "goal": "Build a compact map of the field.",
      "actions": [
        "identify central questions",
        "select foundational concepts and methods",
        "locate evidence standards and representative cases"
      ],
      "evidence": [
        "field map",
        "curated source list"
      ]
    },
    {
      "id": "understand",
      "order": 4,
      "goal": "Develop explanatory understanding across representations.",
      "actions": [
        "explain mechanisms and assumptions",
        "translate between representations",
        "compare alternative models"
      ],
      "evidence": [
        "learner explanation",
        "concept or representation map"
      ]
    },
    {
      "id": "practice",
      "order": 5,
      "goal": "Perform authentic tasks with progressively reduced scaffolding.",
      "actions": [
        "complete bounded tasks",
        "seek feedback",
        "revise methods and artifacts"
      ],
      "evidence": [
        "work sample",
        "feedback and revision record"
      ]
    },
    {
      "id": "verify",
      "order": 6,
      "goal": "Check claims, methods, and results.",
      "actions": [
        "inspect sources and provenance",
        "test assumptions and predictions",
        "reproduce representative steps"
      ],
      "evidence": [
        "claim-evidence record",
        "verification or reproduction log"
      ]
    },
    {
      "id": "reflect",
      "order": 7,
      "goal": "Make learning and assistance inspectable.",
      "actions": [
        "describe changed understanding",
        "record accepted and rejected assistance",
        "identify remaining uncertainty"
      ],
      "evidence": [
        "reflection",
        "agent contribution record when applicable"
      ]
    },
    {
      "id": "transfer",
      "order": 8,
      "goal": "Adapt capability to a new context.",
      "actions": [
        "solve a novel but related task",
        "explain what transfers and what changes"
      ],
      "evidence": [
        "transfer task",
        "adaptation rationale"
      ]
    },
    {
      "id": "create",
      "order": 9,
      "goal": "Make an original contribution.",
      "actions": [
        "formulate a new question",
        "design an artifact, method, or investigation",
        "test and critique the contribution"
      ],
      "evidence": [
        "original artifact or proposal",
        "test and limitation record"
      ]
    },
    {
      "id": "contribute-steward",
      "order": 10,
      "goal": "Share knowledge and take responsibility for consequences.",
      "actions": [
        "communicate results and limitations",
        "consider affected stakeholders",
        "maintain or correct shared work"
      ],
      "evidence": [
        "public explanation or handoff",
        "impact and maintenance plan"
      ]
    }
  ],
  "principles": [
    "revisitable-not-linear",
    "evidence-over-completion",
    "learner-agency",
    "transparent-agent-assistance",
    "multimodal-representation",
    "privacy-minimization",
    "contextual-and-accessible-adaptation"
  ],
  "assessment_modes": [
    "explain",
    "perform",
    "transfer",
    "create",
    "reflect-and-account"
  ],
  "review": {
    "expert_review": "not-started",
    "learner_pilot": "not-started",
    "accessibility_review": "not-started",
    "cross_context_validation": "not-started"
  }
}

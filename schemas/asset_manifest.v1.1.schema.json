{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.v1.1.schema.json",
  "title": "asset_manifest.v1.1 (KF task_type=01-asset-registration, package-agnostic)",
  "description": "Reusable, package-agnostic shape of asset_manifest.json for knowledge-factory work packages of task_type=01-asset-registration. Same field set as asset_manifest.v1.schema.json, but the per-package consts (package_id/report_id/uri) are replaced by patterns so that one schema serves every report; v1 stays untouched for the package that pinned it. Resolution semantics used by producers of this schema: resolved_in_source = the asset body is contained in the report markdown payload and its locator quote is a unique substring; referenced_unresolved = named by the report but not contained in the payload (resolution_check records the strongest external evidence found: present/unresolved/absent); declared_absent = the report itself declares the item out of scope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "package_id", "task_type", "report_id", "source", "counts", "assets", "claims", "integrity"],
  "properties": {
    "schema": {"const": "asset_manifest.v1"},
    "package_id": {"type": "string", "pattern": "^wp-[A-Za-z0-9][A-Za-z0-9_.:-]*-[0-9]{2}$"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"type": "string", "pattern": "^[0-9]+$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "field", "hash_alg", "hash", "chars", "bytes_utf8", "title", "scenario_key"],
      "properties": {
        "uri": {"type": "string", "pattern": "^tensor://reports/[0-9]+$"},
        "field": {"const": "markdown"},
        "hash_alg": {"const": "sha256"},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "chars": {"type": "integer", "minimum": 1},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "scenario_key": {"type": "string", "minLength": 1},
        "platform_mission_id": {"type": ["integer", "string", "null"]},
        "platform_status": {"type": ["string", "null"]},
        "platform_figures": {"type": "array"},
        "platform_tags": {"type": "array"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assets", "by_class", "by_resolution", "resolved_in_source", "referenced_unresolved", "declared_absent"],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object"},
        "by_resolution": {"type": "object"},
        "resolved_in_source": {"type": "integer", "minimum": 0},
        "referenced_unresolved": {"type": "integer", "minimum": 0},
        "declared_absent": {"type": "integer", "minimum": 0}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "asset_class", "label", "in_report_section", "locator", "resolution", "resolution_check", "note"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_class": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "resolution": {"enum": ["resolved_in_source", "referenced_unresolved", "declared_absent"]},
          "note": {"type": "string"},
          "resolution_check": {
            "type": "object",
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string"},
              "result": {"enum": ["resolved", "unresolved", "absent", "present"]},
              "searched": {"type": "string"},
              "probe": {"type": "array"}
            }
          },
          "locator": {
            "type": "object",
            "required": ["method", "start_char", "end_char", "start_line", "end_line", "quote", "unique"],
            "properties": {
              "method": {"enum": ["char_span", "document"]},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 0},
              "end_line": {"type": "integer", "minimum": 0},
              "quote": {"type": "string", "minLength": 1},
              "unique": {"type": "boolean"}
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate for task_type 01 (register only). Any claim must carry evidence or an explicit status; verified is not an allowed status here (verification is computed by the platform gate).",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "anyOf": [{"required": ["evidence_locator"]}, {"required": ["status"]}, {"required": ["evidence"]}],
        "properties": {
          "claim_id": {"type": "string", "minLength": 3},
          "text": {"type": "string", "minLength": 1},
          "status": {"enum": ["supported", "partially-supported", "unresolved", "refuted"]},
          "evidence_locator": {"type": "object"},
          "evidence": {"type": "array"}
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": ["quote_uniqueness", "hash_recomputed_locally", "hash_matches_contract"],
      "properties": {
        "quote_uniqueness": {"type": "string"},
        "hash_recomputed_locally": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hash_matches_contract": {"type": "boolean"},
        "contract_chars_match": {"type": "boolean"},
        "content_span_coverage": {"type": "string"},
        "verified_claims": {"type": "integer", "minimum": 0},
        "verification_note": {"type": "string"}
      }
    }
  }
}
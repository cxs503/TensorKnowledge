{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.v1.generic.schema.json",
  "title": "asset_manifest.v1 (generic form, KF work package task_type=01-asset-registration)",
  "description": "Package-agnostic form of schemas/asset_manifest.v1.schema.json (which pins package_id=wp-448-01). Identical structure; the 448/6551-specific constants are relaxed to patterns so the same shape can gate every 01-asset-registration package. Where the platform-side schema (schemas/kf_result.v1.schema.json) applies to the envelope, that schema wins; this one only pins the manifest payload.",
  "type": "object",
  "required": ["schema", "package_id", "task_type", "report_id", "source", "counts", "assets", "claims", "integrity"],
  "properties": {
    "schema": {"const": "asset_manifest.v1"},
    "manifest_version": {"type": "string"},
    "package_id": {"type": "string", "pattern": "^wp-[A-Za-z0-9][A-Za-z0-9_.:-]*-[0-9]{2}$"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"type": "string", "pattern": "^[0-9]+$"},
    "lane": {"type": "string"},
    "generated_at": {"type": "string"},
    "producer": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["uri", "field", "hash_alg", "hash", "chars", "bytes_utf8", "title", "scenario_key"],
      "properties": {
        "uri": {"type": "string", "pattern": "^tensor://reports/[0-9]+$"},
        "report_id": {"type": "string", "pattern": "^[0-9]+$"},
        "field": {"const": "markdown"},
        "hash_alg": {"const": "sha256"},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "contract_source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "hash_match": {"type": "boolean"},
        "chars": {"type": "integer", "minimum": 1},
        "contract_chars": {"type": "integer", "minimum": 1},
        "chars_match_contract": {"type": "boolean"},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "lines": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "scenario_key": {"type": "string", "minLength": 1},
        "contract_title": {"type": "string"},
        "contract_scenario_key": {"type": "string"},
        "title_matches_contract": {"type": "boolean"},
        "scenario_matches_contract": {"type": "boolean"},
        "platform_figures": {"type": "array"},
        "platform_tags": {"type": "array"}
      }
    },
    "counts": {
      "type": "object",
      "required": ["assets", "by_class", "by_resolution", "resolved_in_source", "referenced_unresolved", "declared_absent"],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object"},
        "by_resolution": {"type": "object"},
        "resolved_in_source": {"type": "integer", "minimum": 0},
        "referenced_unresolved": {"type": "integer", "minimum": 0},
        "declared_absent": {"type": "integer", "minimum": 0}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "asset_class", "label", "in_report_section", "locator", "resolution", "resolution_check", "note"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^[A-Za-z0-9:._-]{3,64}$"},
          "asset_class": {"type": "string", "minLength": 1},
          "kind": {"type": "string"},
          "label": {"type": "string", "minLength": 1},
          "name": {"type": "string"},
          "in_report_section": {"type": "string", "minLength": 1},
          "resolution": {"enum": ["resolved_in_source", "referenced_unresolved", "declared_absent"]},
          "resolution_detail": {"type": "object"},
          "resolution_check": {
            "type": "object",
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string"},
              "result": {"enum": ["resolved", "unresolved", "absent", "present"]}
            }
          },
          "locator": {
            "type": "object",
            "required": ["method", "start_char", "end_char", "start_line", "end_line", "quote", "unique"],
            "properties": {
              "method": {"enum": ["char_span", "document"]},
              "source_field": {"enum": ["markdown", "record"]},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 0},
              "end_line": {"type": "integer", "minimum": 0},
              "quote": {"type": "string", "minLength": 1},
              "quote_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "unique": {"type": "boolean"}
            }
          },
          "note": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate for this package (objective.classify_report_type=false, no extraction). Each claim, if any, must carry an evidence locator or an explicit status.",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "anyOf": [{"required": ["evidence_locator"]}, {"required": ["status"]}]
      }
    },
    "claims_empty_reason": {"type": "string"},
    "integrity": {
      "type": "object",
      "required": ["quote_uniqueness", "hash_recomputed_locally", "hash_matches_contract"],
      "properties": {
        "quote_uniqueness": {"type": "object"},
        "hash_recomputed_locally": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "hash_matches_contract": {"type": "boolean"}
      }
    }
  }
}
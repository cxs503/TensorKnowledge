{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.wp-13946-01.schema.json",
  "title": "asset_manifest.v1 pinned for KF work package wp-13946-01 (report 13946)",
  "description": "Local, package-pinned schema for artifacts/wp-13946-01/asset_manifest.json. Pin rationale: schemas/asset_manifest.v1.schema.json hard-codes package_id='wp-448-01' / report_id='448' as consts, so it cannot validate any other package; instead of loosening a shared file (which would silently weaken every other package's check) this sibling pins the identity of THIS package. Structural acceptance items (valid_json, schema_pass, source_locator_resolvable, source_hash_matches, no_duplicate_ids, claims evidence/status) are checked by scripts/kf_verify_13946.py. If the platform-side canonical schema differs, the platform gate wins and this artifact must be revised.",
  "type": "object",
  "required": ["schema", "package_id", "task_type", "report_id", "source", "counts", "assets", "claims", "integrity"],
  "properties": {
    "schema": {"const": "asset_manifest.v1"},
    "package_id": {"const": "wp-13946-01"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"const": "13946"},
    "source": {
      "type": "object",
      "required": ["uri", "field", "hash_alg", "hash", "chars", "bytes_utf8", "title", "scenario_key"],
      "properties": {
        "uri": {"const": "tensor://reports/13946"},
        "field": {"const": "markdown"},
        "hash_alg": {"const": "sha256"},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "chars": {"const": 5534},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "scenario_key": {"const": "shear_cell_servo_audit"},
        "platform_figures": {"type": "array"},
        "platform_tags": {"type": "array"}
      }
    },
    "counts": {
      "type": "object",
      "required": ["assets", "by_class", "by_resolution", "resolved_in_source", "referenced_unresolved", "declared_absent"],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object"},
        "by_resolution": {"type": "object"},
        "resolved_in_source": {"type": "integer", "minimum": 0},
        "referenced_unresolved": {"type": "integer", "minimum": 0},
        "declared_absent": {"type": "integer", "minimum": 0}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "asset_class", "label", "in_report_section", "locator", "resolution", "resolution_check", "note"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_class": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "resolution": {"enum": ["resolved_in_source", "referenced_unresolved", "declared_absent"]},
          "resolution_check": {
            "type": "object",
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string"},
              "result": {"enum": ["resolved", "unresolved", "absent", "present"]}
            }
          },
          "locator": {
            "type": "object",
            "required": ["method", "start_char", "end_char", "start_line", "end_line", "quote", "unique"],
            "properties": {
              "method": {"enum": ["char_span", "document"]},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 0},
              "end_line": {"type": "integer", "minimum": 0},
              "quote": {"type": "string", "minLength": 1},
              "unique": {"const": true}
            }
          },
          "note": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate for this package (objective.register_assets=true, classify_report_type=false, no extraction). Each claim, if any, must carry evidence or an explicit unresolved status.",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "anyOf": [
          {"required": ["evidence"]},
          {"required": ["evidence_locator"]},
          {"required": ["status"]}
        ]
      }
    },
    "claims_note": {"type": "string"},
    "integrity": {
      "type": "object",
      "required": ["quote_uniqueness", "hash_recomputed_locally", "hash_matches_contract"],
      "properties": {
        "quote_uniqueness": {"type": "string"},
        "hash_recomputed_locally": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hash_matches_contract": {"const": true},
        "char_count_matches_contract": {"const": true},
        "char_span_recheck": {"type": "string"},
        "verified_by_platform_gate": {"const": false}
      }
    }
  }
}
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.wp-11107-01.schema.json",
  "title": "asset_manifest.json for KF work package wp-11107-01 (task_type 01-asset-registration)",
  "description": "Package-local schema for the asset manifest of report 11107. The envelope (kf_result.json) is validated against the canonical schemas/kf_result.v1.schema.json; this file pins the shape of the manifest that goes inside outputs['asset_manifest.json'] so acceptance item schema_pass is a reproducible check. It is derived from the earlier asset_manifest.v1 schema (wp-448-01) with the identity consts re-pinned to wp-11107-01 and one extra resolution value (resolved_external) for artefacts whose bytes are located outside source_uri. If a platform-side schema for this工序 exists, the platform gate wins and this file must be revised.",
  "type": "object",
  "required": [
    "schema",
    "package_id",
    "task_type",
    "report_id",
    "source",
    "assets",
    "counts",
    "id_integrity",
    "claims",
    "claims_empty_reason"
  ],
  "properties": {
    "schema": {"const": "asset_manifest.wp-11107-01"},
    "package_id": {"const": "wp-11107-01"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"const": "11107"},
    "lane": {"const": "C"},
    "source": {
      "type": "object",
      "required": [
        "report_id",
        "uri",
        "field",
        "hash_alg",
        "hash",
        "hash_matches_contract",
        "chars",
        "chars_match_contract",
        "bytes_utf8",
        "lines",
        "record"
      ],
      "properties": {
        "report_id": {"const": "11107"},
        "uri": {"const": "tensor://reports/11107"},
        "field": {"const": "markdown"},
        "hash_alg": {"const": "sha256"},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hash_matches_contract": {"const": true},
        "chars": {"type": "integer", "minimum": 1},
        "chars_match_contract": {"const": true},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "lines": {"type": "integer", "minimum": 1},
        "record": {
          "type": "object",
          "required": [
            "title",
            "title_matches_contract",
            "scenario_key",
            "scenario_matches_contract",
            "figures_declared"
          ]
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "asset_class",
          "label",
          "in_report_section",
          "locator",
          "resolution",
          "resolution_check",
          "note"
        ],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_class": {
            "enum": [
              "source_document",
              "figure_reference",
              "producer_workspace_reference",
              "code_reference",
              "data_artifact_reference"
            ]
          },
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "resolution": {
            "enum": [
              "resolved_in_source",
              "resolved_external",
              "referenced_unresolved",
              "declared_absent"
            ]
          },
          "resolution_check": {
            "type": "object",
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string", "minLength": 1},
              "result": {"enum": ["resolved", "unresolved", "absent"]}
            }
          },
          "locator": {
            "type": "object",
            "required": [
              "method",
              "start_char",
              "end_char",
              "start_line",
              "end_line",
              "quote",
              "unique"
            ],
            "properties": {
              "method": {"enum": ["char_span", "document"]},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 1},
              "end_line": {"type": "integer", "minimum": 1},
              "quote": {"type": "string", "minLength": 1},
              "unique": {"type": "boolean"}
            }
          },
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["assets", "by_class", "by_resolution", "claims"],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object"},
        "by_resolution": {"type": "object"},
        "claims": {"const": 0}
      }
    },
    "id_integrity": {
      "type": "object",
      "required": ["ids_checked", "duplicates", "unique"],
      "properties": {
        "ids_checked": {"type": "integer", "minimum": 1},
        "duplicates": {"type": "array", "maxItems": 0},
        "unique": {"const": true}
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 0,
      "description": "Empty is the complete result for this package (objective.classify_report_type=false, no extraction)."
    },
    "claims_empty_reason": {"type": "string", "minLength": 20}
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cxs503/TensorKnowledge/blob/main/schemas/failure-card.schema.json",
  "title": "Failure Card",
  "description": "A failure card captures negative knowledge: failure mode + root cause + workaround. Aligned with negative_knowledge_ledger. It is a specialization of the claim record (claim_type=hypothesis or methodological) for documented failures.",
  "type": "object",
  "required": [
    "id",
    "card_type",
    "failure_mode",
    "root_cause",
    "created_at",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^tkc:[a-z][a-z0-9-]*:[a-z0-9][a-z0-9-]*$"
    },
    "card_type": {
      "const": "failure"
    },
    "failure_mode": {
      "type": "object",
      "required": ["description", "symptom"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "symptom": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["critical", "major", "minor", "cosmetic"] },
        "trigger_conditions": { "type": "array", "items": { "type": "string" } },
        "affected_domain": { "type": "string" },
        "affected_method": { "type": "string" }
      },
      "additionalProperties": false
    },
    "root_cause": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "category": { "enum": ["numerical", "algorithmic", "implementation", "model", "data", "configuration", "other"] },
        "mechanism": { "type": "string" },
        "evidence": { "type": "string" }
      },
      "additionalProperties": false
    },
    "workaround": {
      "type": "object",
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "effectiveness": { "enum": ["full", "partial", "temporary", "none"] },
        "side_effects": { "type": "array", "items": { "type": "string" } },
        "parameter_adjustment": { "type": "object" }
      },
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "properties": {
        "status": { "enum": ["unresolved", "workaround-available", "fixed", "accepted-limitation"] },
        "fix_reference": { "type": "string" },
        "fixed_in_version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "claim_type": {
      "enum": ["hypothesis", "methodological", "causal"]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "epistemic_status": {
      "enum": ["draft", "established", "well-supported", "provisional", "contested", "speculative", "superseded", "not-assessed"]
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^tke:[a-z][a-z0-9-]*:[a-z0-9][a-z0-9-]*$" },
      "uniqueItems": true
    },
    "scope": {
      "type": "object",
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "system": { "type": "string" },
        "conditions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "modality": {
      "enum": ["asserted", "conditional", "probabilistic", "hypothetical", "normative", "question"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "supersedes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "notes": { "type": "array", "items": { "type": "string" } },
    "negative_knowledge_ledger_ref": {
      "type": "string",
      "description": "Reference to the corresponding entry in negative_knowledge_ledger (if applicable)"
    }
  },
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.wp-13278-01.schema.json",
  "title": "asset_manifest v1 — package-scoped profile for wp-13278-01 (report 13278)",
  "description": "Package-scoped profile of schemas/asset_manifest.v1.schema.json: same shape, with the report/package constants pinned so that the schema_pass acceptance item is a reproducible check rather than an assertion. schemas/asset_manifest.v1.schema.json is the shared v1 shape but pins package_id='wp-448-01' via const, so it cannot validate another package; that file is left untouched (upstream product of another work package) and this profile is the validating copy for wp-13278-01. If the platform-side schema differs, the platform gate wins and the artifact must be revised.",
  "type": "object",
  "required": ["schema", "package_id", "task_type", "report_id", "source", "counts", "assets", "claims", "integrity"],
  "properties": {
    "schema": {"const": "asset_manifest.v1"},
    "package_id": {"const": "wp-13278-01"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"const": "13278"},
    "source": {
      "type": "object",
      "required": ["uri", "field", "hash_alg", "hash", "chars", "bytes_utf8", "title", "scenario_key"],
      "properties": {
        "uri": {"const": "tensor://reports/13278"},
        "field": {"const": "markdown"},
        "hash_alg": {"const": "sha256"},
        "hash": {"const": "f9c336f0d77c618b2a03ff4dd4fbc7d04b0d78a16bb29406537cfac742dcc90f"},
        "chars": {"type": "integer", "minimum": 1},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "scenario_key": {"type": "string", "minLength": 1},
        "platform_id": {"type": "integer"},
        "platform_mission_id": {"type": ["integer", "null"]},
        "platform_status": {"type": ["string", "null"]},
        "platform_figures": {"type": "array"},
        "platform_tags": {"type": "array"},
        "contract_title": {"type": "string"},
        "contract_chars": {"type": "integer"},
        "retrieved_via": {"type": "string"},
        "local_copy": {"type": "string"}
      }
    },
    "counts": {
      "type": "object",
      "required": ["assets", "by_class", "by_resolution", "resolved_in_source", "referenced_unresolved", "declared_absent"],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object"},
        "by_resolution": {"type": "object"},
        "resolved_in_source": {"type": "integer", "minimum": 0},
        "referenced_unresolved": {"type": "integer", "minimum": 0},
        "declared_absent": {"type": "integer", "minimum": 0}
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "covered_chars": {"type": "integer", "minimum": 0},
        "source_chars": {"type": "integer", "minimum": 1},
        "pct": {"type": "number", "minimum": 0, "maximum": 100},
        "method": {"type": "string"}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "asset_class", "label", "in_report_section", "locator", "resolution", "resolution_check", "note"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_class": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "resolution": {"enum": ["resolved_in_source", "referenced_unresolved", "declared_absent"]},
          "resolution_check": {
            "type": "object",
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string"},
              "result": {"enum": ["resolved", "unresolved", "absent", "present"]},
              "detail": {"type": "string"},
              "probe": {"type": "object"},
              "quote_len": {"type": "integer"},
              "platform_figures_count": {"type": "integer"}
            }
          },
          "locator": {
            "type": "object",
            "required": ["method", "start_char", "end_char", "start_line", "end_line", "quote", "unique"],
            "properties": {
              "method": {"enum": ["char_span", "document"]},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 0},
              "end_line": {"type": "integer", "minimum": 0},
              "quote": {"type": "string", "minLength": 1},
              "unique": {"const": true}
            }
          },
          "note": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate for this package (objective.classify_report_type=false, no extraction). Each claim, if any, must carry evidence or an explicit non-verified status.",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "anyOf": [{"required": ["evidence_locator"]}, {"required": ["status"]}, {"required": ["evidence"]}],
        "properties": {
          "status": {"enum": ["supported", "partially-supported", "unresolved", "refuted"]}
        }
      }
    },
    "claims_note": {"type": "string"},
    "integrity": {
      "type": "object",
      "required": ["quote_uniqueness", "hash_recomputed_locally", "hash_matches_contract"],
      "properties": {
        "quote_uniqueness": {"type": "string"},
        "hash_recomputed_locally": {"const": true},
        "hash_matches_contract": {"const": true},
        "chars_matches_contract": {"type": "boolean"}
      }
    }
  }
}
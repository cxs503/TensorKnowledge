{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.wp-9840-01.schema.json",
  "title": "asset_manifest.v1 — pinned instance schema for work package wp-9840-01 (report 9840)",
  "description": "Package-scoped companion to schemas/asset_manifest.v1.schema.json (that file pins package_id=wp-448-01, i.e. another package's contract, so it cannot be reused verbatim). This file pins the shape actually emitted by scripts/kf_register_9840.py (32 fragment assets; whole-document registration is carried by source.hash, see integrity.document_registration) so that acceptance item schema_pass is a re-runnable check rather than an assertion. The result envelope itself is validated against the unmodified repo schema schemas/kf_result.v1.schema.json. If the platform-side schema differs, the platform gate wins and this artifact must be revised.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package_id",
    "task_type",
    "report_id",
    "source",
    "counts",
    "assets",
    "claims",
    "claims_note",
    "integrity"
  ],
  "properties": {
    "schema": {
      "const": "asset_manifest.v1"
    },
    "package_id": {
      "const": "wp-9840-01"
    },
    "task_type": {
      "const": "01-asset-registration"
    },
    "report_id": {
      "const": "9840"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "field",
        "hash_alg",
        "hash",
        "chars",
        "bytes_utf8",
        "title",
        "scenario_key",
        "retrieved_via",
        "local_copy",
        "fetch_script"
      ],
      "properties": {
        "uri": {
          "const": "tensor://reports/9840"
        },
        "field": {
          "const": "markdown"
        },
        "hash_alg": {
          "const": "sha256"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "chars": {
          "type": "integer",
          "minimum": 1
        },
        "bytes_utf8": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scenario_key": {
          "type": "string",
          "minLength": 1
        },
        "platform_id": {
          "type": [
            "integer",
            "string"
          ]
        },
        "platform_mission_id": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "platform_figures": {
          "type": "array"
        },
        "platform_tags": {
          "type": "array"
        },
        "retrieved_via": {
          "type": "string",
          "pattern": "^GET "
        },
        "local_copy": {
          "type": "string",
          "minLength": 1
        },
        "fetch_script": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assets",
        "by_class",
        "by_resolution",
        "resolved_in_source",
        "referenced_unresolved",
        "declared_absent"
      ],
      "properties": {
        "assets": {
          "type": "integer",
          "minimum": 1
        },
        "by_class": {
          "type": "object",
          "minProperties": 1
        },
        "by_resolution": {
          "type": "object",
          "minProperties": 1
        },
        "resolved_in_source": {
          "type": "integer",
          "minimum": 0
        },
        "referenced_unresolved": {
          "type": "integer",
          "minimum": 0
        },
        "declared_absent": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "asset_class",
          "label",
          "in_report_section",
          "locator",
          "resolution",
          "resolution_check",
          "note"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^A[0-9]{2}$"
          },
          "asset_class": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "in_report_section": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "enum": [
              "resolved_in_source",
              "referenced_unresolved",
              "declared_absent"
            ]
          },
          "resolution_check": {
            "type": "object",
            "required": [
              "check",
              "result"
            ],
            "properties": {
              "check": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "resolved",
                  "unresolved",
                  "absent",
                  "present"
                ]
              },
              "detail": {
                "type": "string"
              },
              "unique": {
                "type": "boolean"
              },
              "quote_chars": {
                "type": "integer"
              },
              "referenced_candidates": {
                "type": "array"
              },
              "found_in_worktree": {
                "type": "array"
              },
              "section_lines": {
                "type": "integer"
              },
              "body_chars": {
                "type": "integer"
              },
              "platform_figures_count": {
                "type": "integer"
              },
              "platform_figure_names": {
                "type": "array"
              }
            }
          },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "start_char",
              "end_char",
              "start_line",
              "end_line",
              "quote",
              "unique"
            ],
            "properties": {
              "method": {
                "enum": [
                  "char_span",
                  "document"
                ]
              },
              "start_char": {
                "type": "integer",
                "minimum": 0
              },
              "end_char": {
                "type": "integer",
                "minimum": 1
              },
              "start_line": {
                "type": "integer",
                "minimum": 0
              },
              "end_line": {
                "type": "integer",
                "minimum": 0
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "unique": {
                "type": "boolean"
              },
              "shared_span_with": {
                "type": "string",
                "pattern": "^A[0-9]{2}$"
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate for this package (objective.register_assets only, classify_report_type=false, no extraction). Each claim, if any, must carry an evidence locator or an explicit status.",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "text"
        ],
        "anyOf": [
          {
            "required": [
              "evidence_locator"
            ]
          },
          {
            "required": [
              "status"
            ]
          }
        ]
      }
    },
    "claims_note": {
      "type": "string",
      "minLength": 1
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote_uniqueness",
        "quotes_sliced_not_retyped",
        "hash_recomputed_locally",
        "hash_matches_contract",
        "document_registration"
      ],
      "properties": {
        "quote_uniqueness": {
          "type": "string"
        },
        "quotes_sliced_not_retyped": {
          "const": true
        },
        "hash_recomputed_locally": {
          "const": true
        },
        "hash_matches_contract": {
          "const": true
        },
        "document_registration": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.wp-9706-01.schema.json",
  "title": "asset_manifest (KF work package wp-9706-01, task_type=01-asset-registration, report 9706)",
  "description": "Locally pinned schema for artifacts/wp-9706-01/asset_manifest.json. Shape follows schemas/asset_manifest.v1.schema.json (the wp-448-01 pin), with the identity fields constrained to this work package so that the acceptance item schema_pass is a reproducible check instead of an assertion. The platform-side gate wins if it disagrees; in that case this artifact must be revised, not the gate.",
  "type": "object",
  "required": ["schema", "package_id", "task_type", "report_id", "source", "conventions", "counts", "assets", "claims", "integrity"],
  "properties": {
    "schema": {"const": "asset_manifest.v1"},
    "package_id": {"const": "wp-9706-01"},
    "task_type": {"const": "01-asset-registration"},
    "contract_version": {"const": "1.0"},
    "report_id": {"const": "9706"},
    "source": {
      "type": "object",
      "required": ["uri", "field", "hash_alg", "hash", "chars", "bytes_utf8", "title", "scenario_key"],
      "additionalProperties": true,
      "properties": {
        "uri": {"const": "tensor://reports/9706"},
        "field": {"const": "markdown"},
        "hash_alg": {"const": "sha256"},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "chars": {"type": "integer", "minimum": 1},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "scenario_key": {"type": "string", "minLength": 1},
        "contract_title": {"type": "string"},
        "contract_scenario_key": {"type": "string"},
        "platform_id": {},
        "platform_mission_id": {},
        "platform_figures": {"type": "array"},
        "platform_tags": {"type": "array"},
        "retrieved_via": {"type": "string"},
        "local_copy": {"type": "string"}
      }
    },
    "conventions": {
      "type": "object",
      "required": ["char_offsets", "line_numbers", "resolution_meaning"],
      "properties": {
        "char_offsets": {"type": "string"},
        "line_numbers": {"type": "string"},
        "resolution_meaning": {"type": "string"}
      }
    },
    "counts": {
      "type": "object",
      "required": ["assets", "by_class", "by_resolution", "resolved_in_source", "referenced_unresolved", "declared_absent"],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object"},
        "by_resolution": {"type": "object"},
        "resolved_in_source": {"type": "integer", "minimum": 0},
        "referenced_unresolved": {"type": "integer", "minimum": 0},
        "declared_absent": {"type": "integer", "minimum": 0}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "asset_class", "label", "in_report_section", "locator", "resolution", "resolution_check", "note"],
        "additionalProperties": false,
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_class": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "resolution": {"enum": ["resolved_in_source", "referenced_unresolved", "declared_absent"]},
          "resolution_check": {
            "type": "object",
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string", "minLength": 1},
              "result": {"enum": ["resolved", "unresolved", "absent", "present"]}
            }
          },
          "locator": {
            "type": "object",
            "required": ["method", "start_char", "end_char", "start_line", "end_line", "quote", "unique"],
            "additionalProperties": false,
            "properties": {
              "method": {"enum": ["char_span", "document"]},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 1},
              "end_line": {"type": "integer", "minimum": 1},
              "quote": {"type": "string", "minLength": 1},
              "unique": {"type": "boolean"}
            }
          },
          "note": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate for this package (objective.classify_report_type=false, registration only). Each claim, if any, must carry an evidence locator or an explicit status.",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "anyOf": [{"required": ["evidence_locator"]}, {"required": ["status"]}]
      }
    },
    "claims_note": {"type": "string"},
    "integrity": {
      "type": "object",
      "required": ["quote_uniqueness", "hash_recomputed_locally", "hash_matches_contract"],
      "properties": {
        "quote_uniqueness": {"type": "string"},
        "hash_recomputed_locally": {"type": "boolean"},
        "hash_matches_contract": {"type": "boolean"},
        "verification_status": {"type": "string"},
        "verification_note": {"type": "string"}
      }
    }
  }
}
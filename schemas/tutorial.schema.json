{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cxs503/TensorKnowledge/blob/main/schemas/tutorial.schema.json",
  "title": "TensorKnowledge Tutorial Metadata",
  "type": "object",
  "required": [
    "id",
    "title",
    "path",
    "status",
    "version",
    "domains",
    "knowledge_nodes",
    "learning_outcomes",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^tk:tutorial:[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "in-review",
        "pilot",
        "approved",
        "deprecated"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "knowledge_nodes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^tk:"
      },
      "uniqueItems": true
    },
    "learning_outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assessment_dimensions": {
      "type": "array",
      "items": {
        "enum": [
          "understanding",
          "judgment",
          "transfer",
          "creation"
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "citation",
          "author",
          "publication_date",
          "source_type",
          "section",
          "accessed",
          "url",
          "supports"
        ],
        "properties": {
          "citation": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "publication_date": {
            "type": "string",
            "pattern": "^[0-9]{4}(-[0-9]{2}-[0-9]{2})?$"
          },
          "source_type": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "accessed": {
            "type": "string",
            "format": "date"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "identifier": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "supports": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "domain_review": {
          "enum": [
            "not-started",
            "in-progress",
            "passed",
            "changes-requested"
          ]
        },
        "learning_design_review": {
          "enum": [
            "not-started",
            "in-progress",
            "passed",
            "changes-requested"
          ]
        },
        "learner_pilot": {
          "enum": [
            "not-started",
            "in-progress",
            "passed",
            "changes-requested"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

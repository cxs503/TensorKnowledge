{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.v1.wp-9761-01.schema.json",
  "title": "asset_manifest.v1 pinned for work package wp-9761-01 (task_type=01-asset-registration)",
  "description": "Shape actually produced by scripts/kf_register_9761.py for report 9761. The generic file schemas/asset_manifest.v1.schema.json is pinned to wp-448-01 (const literals) and belongs to a different package, so it is not edited; this file pins the same shape for wp-9761-01 so that the acceptance item schema_pass becomes a reproducible check instead of an assertion. The platform-side schema (schemas/kf_result.v1.schema.json) wins on the result envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "package_id", "task_type", "report_id", "source", "counts", "assets", "claims", "claims_note", "observations", "integrity"],
  "properties": {
    "schema": {"const": "asset_manifest.v1"},
    "package_id": {"const": "wp-9761-01"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"const": "9761"},
    "source": {
      "type": "object",
      "required": ["uri", "field", "hash_alg", "hash", "hash_matches_contract", "contract_hash", "chars", "bytes_utf8", "title", "markdown_heading", "scenario_key"],
      "additionalProperties": true,
      "properties": {
        "uri": {"const": "tensor://reports/9761"},
        "field": {"const": "markdown"},
        "hash_alg": {"const": "sha256"},
        "hash": {"const": "4667a18d2c2c183344308980f0b5ef2f018575f060f8129f7e0d8140abca2e2a"},
        "hash_matches_contract": {"const": true},
        "contract_hash": {"const": "sha256:4667a18d2c2c183344308980f0b5ef2f018575f060f8129f7e0d8140abca2e2a"},
        "chars": {"const": 8931},
        "chars_matches_contract": {"const": true},
        "chars_contract": {"const": 8931},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "markdown_heading": {"type": "string", "minLength": 1},
        "scenario_key": {"const": "rigid_contact_energy_ledger_certification"},
        "scenario_key_matches_contract": {"const": true},
        "platform_figures": {"type": "array"},
        "platform_tags": {"type": "array"}
      }
    },
    "counts": {
      "type": "object",
      "required": ["assets", "by_class", "by_resolution", "resolved_in_source", "referenced_unresolved", "declared_absent", "unique_quotes"],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object"},
        "by_resolution": {"type": "object"},
        "resolved_in_source": {"type": "integer", "minimum": 0},
        "referenced_unresolved": {"type": "integer", "minimum": 0},
        "declared_absent": {"type": "integer", "minimum": 0},
        "unique_quotes": {"type": "integer", "minimum": 0}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "asset_class", "label", "in_report_section", "locator", "resolution", "resolution_check", "note"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_class": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "resolution": {"enum": ["resolved_in_source", "referenced_unresolved", "declared_absent"]},
          "resolution_check": {
            "type": "object",
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string"},
              "result": {"enum": ["resolved", "unresolved", "absent", "present"]}
            }
          },
          "locator": {
            "type": "object",
            "required": ["method", "start_char", "end_char", "start_line", "end_line", "quote", "unique"],
            "properties": {
              "method": {"enum": ["char_span", "document"]},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 0},
              "end_line": {"type": "integer", "minimum": 0},
              "quote": {"type": "string", "minLength": 1},
              "unique": {"const": true},
              "occurrences": {"type": "integer", "minimum": 1}
            }
          },
          "note": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate here (objective.classify_report_type=false, notes allow an empty claims array). Any claim must carry evidence or an explicit status.",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "anyOf": [{"required": ["evidence"]}, {"required": ["evidence_locator"]}, {"required": ["status"]}]
      }
    },
    "claims_note": {"type": "string", "minLength": 1},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "text", "evidence_asset"],
        "properties": {
          "id": {"type": "string", "pattern": "^O[0-9]+$"},
          "kind": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "evidence_asset": {"type": "string", "pattern": "^A[0-9]{2}$"}
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": ["hash_recomputed_locally", "hash_matches_contract", "no_asset_id_duplicates", "verified_flags"],
      "properties": {
        "hash_recomputed_locally": {"const": true},
        "hash_matches_contract": {"const": true},
        "no_asset_id_duplicates": {"const": true},
        "verified_flags": {"const": "none (verification is computed by the platform gate)"}
      }
    }
  }
}
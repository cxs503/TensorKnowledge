{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.v2.schema.json",
  "title": "asset_manifest.v2 (KF work package task_type=01-asset-registration, report-agnostic)",
  "description": "Report-agnostic successor of asset_manifest.v1.schema.json. v1 pinned package_id/report_id with `const` (wp-448-01 / 448), so it cannot validate any other registration package; v1 is left untouched because it is the frozen contract of that work package. v2 replaces the consts with patterns, adds counts.resolved_in_platform_record, and admits resolution=resolved_in_platform_record for assets that live in the platform record rather than in the markdown (e.g. figures[] entries). The platform-side kf_result gate wins over this file where they differ.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "package_id", "task_type", "report_id", "source", "counts", "assets", "claims", "integrity"],
  "properties": {
    "schema": {"const": "asset_manifest.v2"},
    "package_id": {"type": "string", "pattern": "^wp-[0-9]+-01$"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"type": "string", "pattern": "^[0-9]+$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "field", "hash_alg", "hash", "chars", "bytes_utf8", "title", "scenario_key"],
      "properties": {
        "uri": {"type": "string", "pattern": "^tensor://reports/[0-9]+$"},
        "field": {"const": "markdown"},
        "hash_alg": {"const": "sha256"},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "chars": {"type": "integer", "minimum": 1},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "scenario_key": {"type": "string", "minLength": 1},
        "platform_figures": {"type": "array"},
        "platform_tags": {"type": "array"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assets", "by_class", "by_resolution", "resolved_in_source",
                   "referenced_unresolved", "declared_absent"],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "by_resolution": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "resolved_in_source": {"type": "integer", "minimum": 0},
        "referenced_unresolved": {"type": "integer", "minimum": 0},
        "declared_absent": {"type": "integer", "minimum": 0},
        "resolved_in_platform_record": {"type": "integer", "minimum": 0}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "asset_class", "label", "in_report_section", "locator",
                     "resolution", "resolution_check", "note"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_class": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "resolution": {
            "enum": ["resolved_in_source", "referenced_unresolved", "declared_absent",
                     "resolved_in_platform_record"]
          },
          "resolution_check": {
            "type": "object",
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string", "minLength": 1},
              "result": {
                "enum": ["resolved", "unresolved", "absent", "present", "resolved_from_platform_record"]
              }
            }
          },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "start_char", "end_char", "start_line", "end_line", "quote", "unique"],
            "properties": {
              "method": {"enum": ["char_span", "document"]},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 0},
              "end_line": {"type": "integer", "minimum": 0},
              "quote": {"type": "string", "minLength": 1},
              "unique": {"const": true}
            }
          },
          "note": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate for this package. Each claim must carry either evidence or an explicit status.",
      "items": {
        "type": "object",
        "required": ["claim_id", "text", "status"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 3},
          "text": {"type": "string", "minLength": 1},
          "status": {"enum": ["supported", "partially-supported", "unresolved", "refuted"]},
          "unresolved_reason": {"type": "string", "minLength": 1},
          "verified": {"type": "boolean"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["quote"]}}
        },
        "allOf": [
          {"if": {"properties": {"status": {"enum": ["unresolved", "partially-supported"]}}},
           "then": {"required": ["unresolved_reason"]}},
          {"if": {"properties": {"status": {"enum": ["supported", "refuted"]}}},
           "then": {"required": ["evidence"]}}
        ]
      }
    },
    "integrity": {
      "type": "object",
      "required": ["quote_uniqueness", "hash_recomputed_locally", "hash_matches_contract"],
      "properties": {
        "quote_uniqueness": {"type": "string"},
        "hash_recomputed_locally": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hash_matches_contract": {"type": "boolean"}
      }
    }
  }
}
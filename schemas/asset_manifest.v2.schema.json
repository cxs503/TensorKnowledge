{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.v2.schema.json",
  "title": "asset_manifest.v2 (KF work package task_type=01-asset-registration, report-agnostic)",
  "description": "Parameterised successor to asset_manifest.v1.schema.json. v1 pins package_id/report_id with `const` (it was written for wp-448-01), so it cannot validate another report's manifest without editing another work package's artefact. v2 keeps v1's field vocabulary and adds: (a) pattern-based package_id/report_id so any report instance can be validated without touching v1; (b) explicit resolution vocabulary resolved_in_source | referenced_unresolved | declared_absent with a per-asset target block required whenever the referenced thing is not resolvable in the source; (c) locator.method enum char_span | document. If the platform-side schema disagrees, the platform gate wins and the artefact must be revised.",
  "type": "object",
  "required": [
    "schema",
    "package_id",
    "task_type",
    "report_id",
    "source",
    "counts",
    "assets",
    "claims",
    "integrity"
  ],
  "properties": {
    "schema": {"const": "asset_manifest.v2"},
    "package_id": {"type": "string", "pattern": "^wp-[A-Za-z0-9][A-Za-z0-9_.:-]*-[0-9]{2}$"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"type": "string", "pattern": "^[0-9]+$"},
    "lane": {"type": "string"},
    "generated_at": {"type": "string"},
    "producer": {"type": "string"},
    "objective": {
      "type": "object",
      "properties": {
        "register_assets": {"type": "boolean"},
        "classify_report_type": {"type": "boolean"},
        "extraction_performed": {"const": false}
      }
    },
    "source": {
      "type": "object",
      "required": [
        "uri",
        "field",
        "hash_alg",
        "hash",
        "hash_matches_contract",
        "chars",
        "bytes_utf8",
        "lines",
        "record_fields"
      ],
      "properties": {
        "uri": {"type": "string", "pattern": "^tensor://reports/[0-9]+$"},
        "field": {"enum": ["markdown", "summary", "record"]},
        "hash_alg": {"const": "sha256"},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hash_prefixed": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "contract_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "hash_matches_contract": {"type": "boolean"},
        "chars": {"type": "integer", "minimum": 1},
        "contract_chars": {"type": "integer", "minimum": 1},
        "chars_match_contract": {"type": "boolean"},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "lines": {"type": "integer", "minimum": 1},
        "has_crlf": {"type": "boolean"},
        "has_trailing_newline": {"type": "boolean"},
        "fetched_via": {"type": "string"},
        "record_fields": {
          "type": "object",
          "required": ["title", "scenario_key"],
          "properties": {
            "title": {"type": ["string", "null"]},
            "scenario_key": {"type": ["string", "null"]},
            "mission_id": {"type": ["integer", "string", "null"]},
            "status": {"type": ["string", "null"]},
            "title_matches_contract": {"type": "boolean"},
            "scenario_matches_contract": {"type": "boolean"}
          }
        },
        "platform_figures": {"type": ["array", "null"]},
        "platform_tags": {"type": ["array", "null"]}
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["heading", "line"],
        "properties": {
          "heading": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1},
          "kind": {"type": "string"}
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "asset_class",
          "label",
          "in_report_section",
          "locator",
          "resolution",
          "resolution_check",
          "note"
        ],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2,3}$"},
          "asset_class": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "resolution": {
            "enum": ["resolved_in_source", "referenced_unresolved", "declared_absent"]
          },
          "resolution_check": {
            "type": "object",
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string", "minLength": 1},
              "result": {"enum": ["resolved", "unresolved", "absent", "present"]},
              "target_probe": {"type": "object"}
            }
          },
          "locator": {
            "type": "object",
            "required": [
              "method",
              "start_char",
              "end_char",
              "start_line",
              "end_line",
              "quote",
              "unique"
            ],
            "properties": {
              "method": {"enum": ["char_span", "document"]},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 1},
              "end_line": {"type": "integer", "minimum": 1},
              "quote": {"type": "string", "minLength": 1},
              "unique": {"type": "boolean"}
            }
          },
          "target": {
            "type": "object",
            "required": ["address_as_written", "kind", "exists_in_worktree"],
            "properties": {
              "address_as_written": {"type": ["string", "null"]},
              "kind": {"type": ["string", "null"]},
              "ext_kind": {"type": "string"},
              "exists_in_worktree": {"type": ["boolean", "null"]},
              "reason": {"type": "string"}
            }
          },
          "note": {"type": "string", "minLength": 1}
        },
        "if": {"properties": {"resolution": {"not": {"const": "resolved_in_source"}}}},
        "then": {"required": ["target"]}
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "declared_in_body_as", "bytes_available"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "declared_in_body_as": {"type": "string", "minLength": 1},
          "declared_body_lines": {"type": "array", "items": {"type": "integer"}},
          "caption_from_record": {"type": ["string", "null"]},
          "has_record_metadata": {"type": "boolean"},
          "bytes_available": {"type": "boolean"},
          "byte_probes": {"type": "array"}
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["assets", "by_class", "by_resolution"],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object"},
        "by_resolution": {"type": "object"},
        "resolved_in_source": {"type": "integer", "minimum": 0},
        "referenced_unresolved": {"type": "integer", "minimum": 0},
        "declared_absent": {"type": "integer", "minimum": 0},
        "claims": {"type": "integer", "minimum": 0}
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate for this package (objective.register_assets=true, classify_report_type=false). Each claim, if any, must carry an evidence locator or an explicit status.",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "anyOf": [
          {"required": ["evidence_locator"]},
          {"required": ["status"]},
          {"required": ["evidence"]}
        ]
      }
    },
    "claims_empty_reason": {"type": "string"},
    "id_integrity": {
      "type": "object",
      "required": ["ids_checked", "duplicates", "unique"],
      "properties": {
        "ids_checked": {"type": "integer", "minimum": 0},
        "duplicates": {"type": "array"},
        "unique": {"type": "boolean"}
      }
    },
    "integrity": {
      "type": "object",
      "required": ["quote_uniqueness", "chars_roundtrip", "hash_recomputed_locally",
                   "hash_matches_contract"],
      "properties": {
        "quote_uniqueness": {"type": "object"},
        "chars_roundtrip": {"type": "boolean"},
        "hash_recomputed_locally": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hash_matches_contract": {"type": "boolean"}
      }
    },
    "unresolved": {"type": "array"},
    "observations": {"type": "array"}
  }
}
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.v1.kf-package.schema.json",
  "title": "asset_manifest.v1 (KF work package task_type=01-asset-registration) — package-agnostic",
  "description": "Package-agnostic companion to schemas/asset_manifest.v1.schema.json (which pins const package_id/report_id to wp-448-01 and report 448 and therefore cannot validate any other registration package). Shape is deliberately identical: same required keys, same resolution vocabulary. Package identity is bounded by patterns derived from the contract: package_id=wp-<mission>-<seq>, source.uri=tensor://reports/<report_id>, source.hash=sha256:<64 hex>. Registration packages stay diffable across reports because only the const->pattern relaxation differs.",
  "type": "object",
  "required": [
    "schema",
    "package_id",
    "task_type",
    "report_id",
    "source",
    "counts",
    "assets",
    "claims",
    "integrity"
  ],
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "asset_manifest.v1"},
    "package_id": {"type": "string", "pattern": "^wp-[0-9]+-[0-9]{2}$"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"type": "string", "pattern": "^[0-9]+$"},
    "generated_at": {"type": "string"},
    "source": {
      "type": "object",
      "required": [
        "uri",
        "field",
        "hash_alg",
        "hash",
        "chars",
        "bytes_utf8",
        "title",
        "scenario_key"
      ],
      "properties": {
        "uri": {"type": "string", "pattern": "^tensor://reports/[0-9]+$"},
        "field": {"enum": ["markdown", "summary", "record"]},
        "hash_alg": {"const": "sha256"},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "chars": {"type": "integer", "minimum": 1},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "title_matches_contract": {"type": "boolean"},
        "chars_matches_contract": {"type": "boolean"},
        "scenario_key": {"type": "string", "minLength": 1},
        "platform_figures": {"type": "array"},
        "platform_tags": {"type": "array"},
        "markdown_snapshot": {"type": "string"}
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "assets",
        "by_class",
        "by_resolution",
        "resolved_in_source",
        "referenced_unresolved",
        "declared_absent"
      ],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object"},
        "by_resolution": {"type": "object"},
        "resolved_in_source": {"type": "integer", "minimum": 0},
        "referenced_unresolved": {"type": "integer", "minimum": 0},
        "declared_absent": {"type": "integer", "minimum": 0},
        "declared_absent_scan": {"type": "object"}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "asset_class",
          "label",
          "in_report_section",
          "locator",
          "resolution",
          "resolution_check",
          "note"
        ],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_class": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "resolution": {"enum": ["resolved_in_source", "referenced_unresolved", "declared_absent"]},
          "locator_points_to": {"enum": ["payload", "mention", "record.figures"]},
          "payload_locator": {"type": "object"},
          "resolution_check": {
            "type": "object",
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string", "minLength": 1},
              "result": {"enum": ["resolved", "unresolved", "absent", "present"]}
            }
          },
          "locator": {
            "type": "object",
            "required": [
              "method",
              "start_char",
              "end_char",
              "start_line",
              "end_line",
              "quote",
              "unique"
            ],
            "properties": {
              "method": {"enum": ["char_span", "document"]},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 0},
              "end_line": {"type": "integer", "minimum": 0},
              "quote": {"type": "string", "minLength": 1},
              "unique": {"type": "boolean"}
            }
          },
          "note": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate for registration packages (no extraction). Each claim, if any, must carry an evidence locator or an explicit status.",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "anyOf": [{"required": ["evidence"]}, {"required": ["status"]}]
      }
    },
    "claims_policy": {"type": "string"},
    "figure_probe": {"type": "object"},
    "integrity": {
      "type": "object",
      "required": ["quote_uniqueness", "hash_recomputed_locally", "hash_matches_contract"],
      "properties": {
        "quote_uniqueness": {"type": "object"},
        "hash_recomputed_locally": {"type": "boolean"},
        "hash_matches_contract": {"type": "boolean"},
        "recomputed_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "contract_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "integrity_findings": {"type": "array"}
  }
}
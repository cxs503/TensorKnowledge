{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cxs503/TensorKnowledge/blob/main/schemas/extraction-skill.schema.json",
  "title": "Extraction Skill",
  "description": "One entry of the Extraction Skill Library (extraction-skills/registry.json). A skill is a reusable, deterministic-per-type extraction program for a report type, not a prose hint. Lifecycle: candidate -> template-created -> sample-tested -> independent-review -> registered -> deprecated. Promotion is only legal with the machine-checkable preconditions below (representative sample tests, independent review event, reuse counter). Direction reference CACHE-ED2: generate a reusable extractor for a new document format, then execute it deterministically for later documents of the same type.",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill_id", "skill_version", "report_type", "lifecycle_state", "steps", "created_at"],
  "properties": {
    "skill_id": { "type": "string", "pattern": "^xsk-[a-z0-9][a-z0-9-]{1,63}$" },
    "skill_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "report_type": {
      "enum": [
        "literature-review",
        "scientific-computation",
        "algorithm-implementation",
        "software-engineering",
        "technical-proposal",
        "experimental-validation"
      ]
    },
    "lifecycle_state": {
      "enum": ["candidate", "template-created", "sample-tested", "independent-review", "registered", "deprecated"]
    },
    "identify_signals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Machine-checkable signals used by process 02 to route a report to this skill (keywords, required sections, artefact kinds). Empty means the skill cannot be auto-selected."
    },
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_fields": { "type": "array", "items": { "enum": ["markdown", "summary", "record"] } },
        "languages": { "type": "array", "items": { "type": "string", "minLength": 2 } },
        "sections": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "instruction"],
        "properties": {
          "step_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
          "instruction": { "type": "string", "minLength": 10 },
          "deterministic": {
            "type": "boolean",
            "description": "true when the step can be executed by a program with no judgement; false when a model must read the text."
          },
          "claim_types_allowed": {
            "type": "array",
            "items": {
              "enum": [
                "definition", "descriptive", "causal", "predictive", "normative",
                "methodological", "mathematical", "interpretive", "hypothesis", "other"
              ]
            }
          }
        }
      }
    },
    "sample_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["report_id", "source_hash", "outcome"],
        "properties": {
          "report_id": { "type": "string", "minLength": 1 },
          "source_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "package_id": { "type": "string", "pattern": "^wp-[a-z0-9][a-z0-9-]{2,63}$" },
          "outcome": { "enum": ["pass", "fail"] },
          "notes": { "type": "string" }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed_at", "reviewer_id", "reviewer_type"],
      "properties": {
        "reviewed_at": { "type": "string", "format": "date-time" },
        "reviewer_id": { "type": "string", "minLength": 1 },
        "reviewer_type": { "enum": ["person", "agent", "organization", "committee"] },
        "review_event_id": { "type": "string", "minLength": 1 }
      }
    },
    "reuse_count": { "type": "integer", "minimum": 0 },
    "deprecated_reason": { "type": "string", "minLength": 10 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "$comment": "sample-tested or later requires at least one passing representative sample.",
      "if": {
        "required": ["lifecycle_state"],
        "properties": {
          "lifecycle_state": { "enum": ["sample-tested", "independent-review", "registered"] }
        }
      },
      "then": {
        "required": ["sample_tests"],
        "properties": { "sample_tests": { "minItems": 1 } }
      }
    },
    {
      "$comment": "independent-review or later requires a recorded independent review event.",
      "if": {
        "required": ["lifecycle_state"],
        "properties": { "lifecycle_state": { "enum": ["independent-review", "registered"] } }
      },
      "then": { "required": ["review"] }
    },
    {
      "$comment": "registered requires a review event identity and the reuse counter, so reuse is auditable.",
      "if": {
        "required": ["lifecycle_state"],
        "properties": { "lifecycle_state": { "const": "registered" } }
      },
      "then": {
        "required": ["review", "reuse_count", "updated_at"],
        "properties": {
          "review": { "required": ["review_event_id"] },
          "reviewer_type": {}
        }
      }
    },
    {
      "$comment": "deprecated requires a stated reason.",
      "if": {
        "required": ["lifecycle_state"],
        "properties": { "lifecycle_state": { "const": "deprecated" } }
      },
      "then": { "required": ["deprecated_reason"] }
    }
  ]
}
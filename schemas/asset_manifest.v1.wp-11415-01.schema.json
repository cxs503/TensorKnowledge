{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.v1.wp-11415-01.schema.json",
  "title": "asset_manifest.v1 for KF work package wp-11415-01 (task_type=01-asset-registration, report 11415)",
  "description": "Pins the exact shape produced by scripts/kf_register_11415.py. Same field family as schemas/asset_manifest.v1.schema.json (which is const-pinned to wp-448-01 and therefore not reusable for another report_id); this file is the machine-checkable half of acceptance item schema_pass for report 11415. If the platform-side schema differs, the platform gate wins and this artifact must be revised.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "package_id", "task_type", "report_id", "source", "counts", "assets", "claims", "claims_note", "integrity"],
  "properties": {
    "schema": {"const": "asset_manifest.v1"},
    "package_id": {"const": "wp-11415-01"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"const": "11415"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "field", "hash_alg", "hash", "chars", "bytes_utf8", "title", "scenario_key", "contract_source_hash", "contract_chars"],
      "properties": {
        "uri": {"const": "tensor://reports/11415"},
        "field": {"const": "markdown"},
        "hash_alg": {"const": "sha256"},
        "hash": {"const": "d8bc42883f1fa1d274a3ca4808586d2a8773e9d0f464b554c944f5090b0c8c50"},
        "chars": {"const": 7903},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "scenario_key": {"const": "ship-performance/stability/weather-criterion-imo-2008"},
        "platform_id": {"const": 11415},
        "platform_mission_id": {"type": ["integer", "null"]},
        "platform_status": {"type": ["string", "null"]},
        "platform_figures": {"type": "array", "items": {"type": "string"}},
        "platform_tags": {"type": "array"},
        "retrieved_via": {"type": "string", "minLength": 1},
        "local_copy": {"type": "string", "minLength": 1},
        "contract_source_hash": {"const": "sha256:d8bc42883f1fa1d274a3ca4808586d2a8773e9d0f464b554c944f5090b0c8c50"},
        "contract_chars": {"const": 7903}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assets", "by_class", "by_resolution", "resolved_in_source", "referenced_unresolved", "declared_absent"],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "by_resolution": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "resolved_in_source": {"type": "integer", "minimum": 0},
        "referenced_unresolved": {"type": "integer", "minimum": 0},
        "declared_absent": {"type": "integer", "minimum": 0}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "asset_class", "label", "in_report_section", "locator", "resolution", "resolution_check", "note"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_class": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "start_char", "end_char", "start_line", "end_line", "quote", "unique"],
            "properties": {
              "method": {"enum": ["char_span", "document"]},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 0},
              "end_line": {"type": "integer", "minimum": 0},
              "quote": {"type": "string", "minLength": 1},
              "unique": {"const": true}
            }
          },
          "resolution": {"enum": ["resolved_in_source", "referenced_unresolved", "declared_absent"]},
          "resolution_check": {
            "type": "object",
            "additionalProperties": true,
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string", "minLength": 1},
              "result": {"enum": ["resolved", "unresolved", "absent", "present"]}
            }
          },
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate for this work package (register_assets only, no claim extraction). Any claim present must carry an evidence locator or an explicit status.",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "anyOf": [{"required": ["evidence"]}, {"required": ["unresolved_reason"]}, {"required": ["status"]}]
      }
    },
    "claims_note": {"type": "string", "minLength": 1},
    "integrity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["quote_uniqueness", "hash_recomputed_locally", "hash_matches_contract", "no_duplicate_ids", "verification_status"],
      "properties": {
        "quote_uniqueness": {"type": "string", "minLength": 1},
        "hash_recomputed_locally": {"const": true},
        "hash_matches_contract": {"const": true},
        "no_duplicate_ids": {"const": true},
        "verification_status": {"const": "not_verified"}
      }
    }
  }
}
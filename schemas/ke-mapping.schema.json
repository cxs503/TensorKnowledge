{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cxs503/TensorKnowledge/blob/main/schemas/ke-mapping.schema.json",
  "title": "Knowledge Engine projection mapping document (v0.1)",
  "description": "Structure of mappings/<pilot>.json as specified by docs/ke/mapping-spec.md §9. Enforces that every record carries a full leaf-path projection ledger and an explicit uncovered[] list, so a loss can only be silent by violating this schema.",
  "type": "object",
  "required": ["spec", "spec_version", "policy_version", "projection_version", "generator", "pilot", "source", "loss_classes", "engine_model", "records", "edges", "vectors", "review_events", "retrieval_demonstrations", "disclosures", "audit"],
  "additionalProperties": true,
  "properties": {
    "spec": {"type": "string", "minLength": 1},
    "spec_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "policy_version": {"type": "string"},
    "projection_version": {"type": "string"},
    "review_policy_version": {"type": "string"},
    "generator": {"type": "string"},
    "pilot": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["repository", "branch", "commit", "path"],
      "properties": {"repository": {"type": "string"}, "branch": {"type": "string"},
                     "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "path": {"type": "string"},
                     "note": {"type": "string"}},
      "additionalProperties": false
    },
    "loss_classes": {"type": "object", "required": ["L0", "L1", "L2", "L3", "L4"],
                     "additionalProperties": {"type": "string"}},
    "engine_model": {"type": "object", "required": ["entity", "edge", "vector", "review_ledger", "raw_rule"]},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["contract", "contract_version", "entity_id", "entity_kind", "source_path", "raw_sha256", "leaf_paths", "projection", "uncovered", "bitemporal"],
        "properties": {
          "contract": {"type": "string"},
          "contract_version": {"type": "string"},
          "entity_id": {"type": "string", "minLength": 1},
          "entity_kind": {"enum": ["claim", "evidence", "provenance", "knowledge-object", "production-result"]},
          "source_path": {"type": "string"},
          "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "raw_bytes": {"type": "integer"},
          "leaf_paths": {"type": "integer", "minimum": 1},
          "projection": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source_path", "engine_slot", "loss_class"],
              "properties": {
                "source_path": {"type": "string", "minLength": 1},
                "engine_slot": {"type": "string", "minLength": 1},
                "loss_class": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
                "note": {"type": "string"},
                "facet": {"type": ["string", "null"]}
              },
              "additionalProperties": false
            }
          },
          "uncovered": {"type": "array", "items": {"type": "object", "required": ["source_path"]}},
          "bitemporal": {"type": "object", "required": ["recorded_at", "valid_time_resolution"]},
          "epistemic_policy": {"type": "object"},
          "flags": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["edge_id", "subject", "predicate", "object", "attrs", "append_only"],
        "properties": {
          "edge_id": {"type": "string", "pattern": "^tke-e:[0-9a-f]{16}$"},
          "subject": {"type": "string"},
          "predicate": {"enum": ["EVIDENCE_OF", "CLAIM_RELATED", "SUPERSEDES", "GENERATED", "USED", "WAS_ASSOCIATED_WITH", "ATTRIBUTED_TO", "DERIVED_FROM", "ARTIFACT_REF", "KO_INCLUDES_CLAIM", "KO_INCLUDES_EVIDENCE", "KO_INCLUDES_PROVENANCE", "KO_NARROWS_TO", "KO_REL", "KO_REL_UNMAPPED", "HAS_REVIEW_EVENT"]},
          "object": {"type": "string"},
          "attrs": {"type": "object"},
          "recorded_at": {"type": "string"},
          "append_only": {"const": true}
        },
        "additionalProperties": false
      }
    },
    "vectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["facet_id", "entity_id", "facet", "text_sha256", "language", "index_status", "filters"],
        "properties": {
          "facet_id": {"type": "string", "pattern": "^fct:[0-9a-f]{12}$"},
          "entity_id": {"type": "string"},
          "facet": {"enum": ["claim.statement", "evidence.quote", "ko.summary"]},
          "source_field_path": {"type": "string"},
          "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "text_chars": {"type": "integer"},
          "language": {"type": "string"},
          "elided": {"type": "boolean"},
          "embedding": {"type": ["array", "null"]},
          "index_status": {"enum": ["declared-not-built", "building", "ready"]},
          "filters": {"type": "object"},
          "retrieval_note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "review_events": {
      "type": "object",
      "required": ["review_events_as_recorded", "fold_result_for_every_entity", "state_machine_conformance", "conformance_passed"],
      "properties": {
        "review_events_as_recorded": {"type": "array"},
        "fold_result_for_every_entity": {"type": "object"},
        "policy_version": {"type": "string"},
        "state_machine_conformance": {"type": "array", "items": {"type": "object", "required": ["case", "expected_code", "observed_code", "pass"]}},
        "conformance_passed": {"type": "boolean"},
        "synthetic_illustration": {"type": "object"}
      },
      "additionalProperties": false
    },
    "retrieval_demonstrations": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["class", "request", "response"],
        "properties": {"class": {"type": "string"}, "request": {"type": "object"}, "response": {"type": "object"}},
        "additionalProperties": false
      }
    },
    "cross_checks": {"type": "object"},
    "disclosures": {
      "type": "array",
      "description": "Explicit loss register. Every entry is a semantic loss the engine model cannot carry; empty is only acceptable when audit.lossless is true AND no semantic gap was found.",
      "items": {
        "type": "object",
        "required": ["id", "class", "severity", "title", "detail", "affected", "disposition"],
        "properties": {
          "id": {"type": "string", "pattern": "^D-[0-9]{2}$"},
          "class": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
          "severity": {"enum": ["blocking", "major", "minor", "informational"]},
          "title": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1},
          "affected": {"type": "array"},
          "disposition": {"type": "string", "minLength": 1},
          "measured_by": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "audit": {
      "type": "object",
      "required": ["records", "leaf_paths_total", "leaf_paths_projected", "leaf_paths_uncovered", "lossless", "disclosures", "acceptance"],
      "properties": {
        "records": {"type": "integer"},
        "by_contract": {"type": "object"},
        "leaf_paths_total": {"type": "integer"},
        "leaf_paths_projected": {"type": "integer"},
        "leaf_paths_uncovered": {"type": "integer"},
        "uncovered_paths": {"type": "array"},
        "lossless": {"type": "boolean"},
        "disclosures": {"type": "integer"},
        "disclosure_classes": {"type": "object"},
        "edges": {"type": "integer"},
        "vector_facets": {"type": "integer"},
        "acceptance": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
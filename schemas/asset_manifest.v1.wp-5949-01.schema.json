{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.v1.wp-5949-01.schema.json",
  "title": "asset_manifest.v1 pinned to work package wp-5949-01 (task_type=01-asset-registration)",
  "description": "Package-local schema for docs/kf/wp-5949-01/asset_manifest.json. The canonical schemas/kf_result.v1.schema.json referenced by the work-package contract is not shipped in this worktree (schemas/ contains no kf_* file), so this schema pins the shape actually produced, making the schema_pass acceptance item reproducible instead of asserted. It is the sibling of schemas/asset_manifest.v1.schema.json (wp-448-01) with package/report consts rebound to wp-5949-01/5949; existing package schemas are left untouched. If the platform-side schema differs, the platform gate wins and this artifact must be revised.",
  "type": "object",
  "required": ["schema", "package_id", "task_type", "report_id", "source", "provenance", "counts", "assets", "claims", "integrity"],
  "properties": {
    "schema": {"const": "asset_manifest.v1"},
    "manifest_version": {"const": "1.0"},
    "package_id": {"const": "wp-5949-01"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"const": "5949"},
    "generated_at": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["uri", "field", "hash_alg", "hash", "chars", "bytes_utf8", "title", "scenario_key"],
      "properties": {
        "uri": {"const": "tensor://reports/5949"},
        "field": {"const": "markdown"},
        "hash_alg": {"const": "sha256"},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "chars": {"type": "integer", "minimum": 1},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "scenario_key": {"type": "string", "minLength": 1},
        "platform_tags": {"type": "array"},
        "platform_figures": {"type": "array"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source_uri", "source_field", "source_hash", "hash_algo"],
      "properties": {
        "source_uri": {"const": "tensor://reports/5949"},
        "source_field": {"const": "markdown"},
        "source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "hash_algo": {"const": "sha256"},
        "source_chars": {"type": "integer", "minimum": 1}
      }
    },
    "counts": {
      "type": "object",
      "required": ["assets", "by_class", "by_resolution", "resolved_in_source", "referenced_unresolved", "declared_absent"],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object"},
        "by_resolution": {"type": "object"},
        "resolved_in_source": {"type": "integer", "minimum": 0},
        "referenced_unresolved": {"type": "integer", "minimum": 0},
        "declared_absent": {"type": "integer", "minimum": 0}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "asset_class", "label", "in_report_section", "locator", "resolution", "resolution_check", "note"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_class": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "resolution": {"enum": ["resolved_in_source", "referenced_unresolved", "declared_absent"]},
          "resolution_check": {
            "type": "object",
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string"},
              "result": {"enum": ["resolved", "unresolved", "absent", "present"]}
            }
          },
          "locator": {
            "type": "object",
            "required": ["method", "start_char", "end_char", "start_line", "end_line", "quote", "unique"],
            "properties": {
              "method": {"enum": ["char_span", "document"]},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 0},
              "end_line": {"type": "integer", "minimum": 0},
              "quote": {"type": "string", "minLength": 1},
              "unique": {"type": "boolean"},
              "quote_exact": {"type": "boolean"}
            }
          },
          "note": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate for this package (objective.classify_report_type=false, no extraction). Each claim, if any, must carry an evidence locator or an explicit non-verified status.",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "anyOf": [{"required": ["evidence_locator"]}, {"required": ["status"]}]
      }
    },
    "integrity": {
      "type": "object",
      "required": ["quote_uniqueness", "hash_recomputed_locally", "hash_matches_contract"],
      "properties": {
        "quote_uniqueness": {"type": "object"},
        "hash_recomputed_locally": {"const": true},
        "hash_matches_contract": {"const": true},
        "chars_match_contract": {"const": true},
        "quotes_are_verbatim_substrings": {"const": true}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
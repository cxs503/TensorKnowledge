{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.v1.wp9656-01.schema.json",
  "title": "asset_manifest.v1 instantiated for KF work package wp-9656-01 (task_type=01-asset-registration)",
  "description": "Local, generalizable instantiation of the asset_manifest.v1 shape for report 9656. Unlike schemas/asset_manifest.v1.schema.json (which pins package_id const 'wp-448-01' and is therefore not reusable), this file constrains only what the wp-9656-01 contract actually requires: package identity, source identity (emitted value is compared to the contract constant by the verify step), and a locator on every asset. It exists so that acceptance item 'schema_pass' is a reproducible machine check; the platform-side schema/gate wins if it differs.",
  "type": "object",
  "additionalProperties": true,
  "required": ["manifest_version", "package_id", "task_type", "report_id", "source", "assets", "claims", "counts", "integrity"],
  "properties": {
    "manifest_version": {"const": "1.0"},
    "package_id": {"const": "wp-9656-01"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"const": "9656"},
    "source": {
      "type": "object",
      "required": ["uri", "source_field", "hash_alg", "source_hash", "chars", "bytes_utf8", "lines", "title", "scenario_key", "hash_matches_contract", "chars_matches_contract", "title_matches_contract"],
      "properties": {
        "uri": {"const": "tensor://reports/9656"},
        "source_field": {"const": "markdown"},
        "hash_alg": {"const": "sha256"},
        "source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "hash_scope": {"type": "string"},
        "chars": {"type": "integer", "minimum": 1},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "lines": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "scenario_key": {"type": "string", "minLength": 1},
        "report_mission_id": {"type": ["integer", "null"]},
        "platform_tags": {"type": "array"},
        "hash_matches_contract": {"type": "boolean"},
        "chars_matches_contract": {"type": "boolean"},
        "title_matches_contract": {"type": "boolean"},
        "contract_source_hash": {"type": "string"},
        "contract_chars": {"type": "integer"}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "kind", "locator", "resolution"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^r9656:[a-z0-9][a-z0-9:_.-]*$"},
          "kind": {
            "enum": [
              "report_markdown",
              "embedded_figure",
              "figure_reference",
              "data_artifact_reference",
              "source_code_reference",
              "document_reference",
              "directory_reference",
              "directory_glob_reference",
              "command_reference"
            ]
          },
          "locator": {
            "type": "object",
            "required": ["method"],
            "properties": {
              "method": {"enum": ["document", "char_span", "record_pointer"]},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 1},
              "end_line": {"type": "integer", "minimum": 1},
              "quote": {"type": "string", "minLength": 1},
              "unique": {"type": "boolean"},
              "line_quote": {"type": "string"},
              "line_occurrences": {"type": "integer", "minimum": 1},
              "source_field": {"enum": ["markdown", "record"]},
              "pointer": {"type": "string"}
            }
          },
          "resolution": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": {"enum": ["resolved", "metadata_only", "unresolved"]},
              "scope": {"type": "string"},
              "via": {"type": "string"},
              "reason": {"type": "string"}
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate for wp-9656-01 (objective.register_assets only; no extraction). Every non-empty entry must carry evidence OR an explicit status.",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "anyOf": [
          {"required": ["evidence"]},
          {"required": ["status"]}
        ],
        "properties": {
          "claim_id": {"type": "string", "minLength": 3},
          "text": {"type": "string", "minLength": 1},
          "status": {"enum": ["supported", "partially-supported", "unresolved", "refuted"]},
          "evidence": {"type": "array"}
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["assets_total", "assets_resolved", "assets_metadata_only", "assets_unresolved", "claims"],
      "properties": {
        "assets_total": {"type": "integer", "minimum": 1},
        "assets_resolved": {"type": "integer", "minimum": 0},
        "assets_metadata_only": {"type": "integer", "minimum": 0},
        "assets_unresolved": {"type": "integer", "minimum": 0},
        "claims": {"type": "integer", "minimum": 0},
        "kind_status_histogram": {"type": "object"}
      }
    },
    "integrity": {
      "type": "object",
      "required": ["hash_recomputed_locally", "hash_matches_contract", "locators_checked", "locators_resolved", "quote_uniqueness", "duplicate_asset_ids"],
      "properties": {
        "hash_recomputed_locally": {"const": true},
        "hash_matches_contract": {"const": true},
        "locators_checked": {"type": "integer", "minimum": 1},
        "locators_resolved": {"type": "integer", "minimum": 0},
        "quote_uniqueness": {"type": "string"},
        "duplicate_asset_ids": {"type": "integer", "minimum": 0}
      }
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.v1.wp-14214-01.schema.json",
  "title": "asset_manifest.v1 (work package wp-14214-01, task_type=01-asset-registration)",
  "description": "Locally written schema for outputs['asset_manifest.json'] of wp-14214-01 (report 14214). Moulded on schemas/asset_manifest.v1.schema.json (wp-448-01 precedent) with the package_id/report_id pins changed to this package, plus the fields this package actually emits (integrity_observations, artifact_endpoint_probe, structure, expansion). The platform-side schema, if any, wins.",
  "type": "object",
  "required": ["schema", "package_id", "task_type", "report_id", "source", "counts", "assets", "claims", "integrity", "integrity_observations"],
  "properties": {
    "schema": {"const": "asset_manifest.v1"},
    "package_id": {"const": "wp-14214-01"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"const": "14214"},
    "source": {
      "type": "object",
      "required": ["uri", "field", "hash_alg", "hash", "chars", "bytes_utf8", "title", "scenario_key", "hash_matches_contract"],
      "properties": {
        "uri": {"const": "tensor://reports/14214"},
        "field": {"const": "markdown"},
        "hash_alg": {"const": "sha256"},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "chars": {"type": "integer", "minimum": 1},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "scenario_key": {"const": "paper-line-w23"},
        "platform_figures": {"type": "array"},
        "platform_tags": {"type": "array"},
        "hash_matches_contract": {"type": "boolean"},
        "chars_matches_contract": {"type": "boolean"}
      }
    },
    "counts": {
      "type": "object",
      "required": ["assets", "by_class", "by_resolution", "resolved_in_source", "referenced_unresolved", "declared_absent"],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object"},
        "by_resolution": {"type": "object"},
        "resolved_in_source": {"type": "integer", "minimum": 0},
        "referenced_unresolved": {"type": "integer", "minimum": 0},
        "declared_absent": {"type": "integer", "minimum": 0},
        "inline_tables_registered": {"type": "integer", "minimum": 0},
        "inline_fenced_blocks": {"type": "integer", "minimum": 0}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "asset_class", "label", "in_report_section", "locator", "resolution", "resolution_check", "content_retrievable", "note"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_class": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "resolution": {"enum": ["resolved_in_source", "referenced_unresolved", "declared_absent"]},
          "content_retrievable": {"type": "boolean"},
          "resolution_check": {
            "type": "object",
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string", "minLength": 1},
              "result": {"enum": ["resolved", "unresolved", "absent", "present"]}
            }
          },
          "locator": {
            "type": "object",
            "required": ["method", "start_char", "end_char", "start_line", "end_line", "quote", "unique"],
            "properties": {
              "method": {"enum": ["char_span", "document"]},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 0},
              "end_line": {"type": "integer", "minimum": 0},
              "quote": {"type": "string", "minLength": 1},
              "unique": {"type": "boolean"}
            }
          },
          "note": {"type": "string", "minLength": 1},
          "structure": {
            "type": "object",
            "required": ["data_rows", "header_cells"],
            "properties": {
              "data_rows": {"type": "integer", "minimum": 0},
              "header_cells": {"type": "integer", "minimum": 1},
              "header_names": {"type": "array", "items": {"type": "string"}},
              "table_line_span": {"type": "integer", "minimum": 1}
            }
          },
          "expansion": {"type": "array", "items": {"type": "string"}},
          "expansion_count": {"type": "integer", "minimum": 0},
          "declared_sha256_16": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
          "record_figure": {"type": ["object", "null"]},
          "record_figure_bound": {"type": "boolean"}
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate here: objective.classify_report_type=false and this package performs no extraction; forcing claims was forbidden by the contract.",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "anyOf": [{"required": ["evidence"]}, {"required": ["status"]}]
      }
    },
    "integrity_observations": {
      "type": "array",
      "description": "Arithmetic / cross-field registration. Status is only resolved|unresolved: nothing here is verified.",
      "items": {
        "type": "object",
        "required": ["obs_id", "kind", "question", "computed", "result", "status", "evidence"],
        "properties": {
          "obs_id": {"type": "string", "pattern": "^O[0-9]{1,2}$"},
          "kind": {"enum": ["arithmetic", "cross_field", "source_shape"]},
          "question": {"type": "string", "minLength": 1},
          "computed": {"type": "object"},
          "result": {"type": "string", "minLength": 1},
          "status": {"enum": ["resolved", "unresolved"]},
          "unresolved_reason": {"type": ["string", "null"]},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["quote", "source_field"],
              "properties": {
                "quote": {"type": "string", "minLength": 1},
                "source_field": {"enum": ["markdown", "summary", "record"]},
                "note": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "artifact_endpoint_probe": {
      "type": "object",
      "required": ["probes", "conclusion"],
      "properties": {
        "base": {"type": "string"},
        "probes": {"type": "array"},
        "conclusion": {"type": "string", "minLength": 1}
      }
    },
    "locator_check_summary": {"type": "object"},
    "integrity": {
      "type": "object",
      "required": ["quote_uniqueness", "hash_recomputed_locally", "hash_matches_contract", "chars_matches_contract"],
      "properties": {
        "quote_uniqueness": {
          "type": "object",
          "required": ["checked", "violations", "all_unique"],
          "properties": {
            "checked": {"type": "integer", "minimum": 1},
            "violations": {"type": "integer", "minimum": 0},
            "all_unique": {"type": "boolean"},
            "note": {"type": "string"}
          }
        },
        "hash_recomputed_locally": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "hash_matches_contract": {"type": "boolean"},
        "chars_contract": {"type": "integer", "minimum": 1},
        "chars_computed": {"type": "integer", "minimum": 1},
        "chars_matches_contract": {"type": "boolean"},
        "source_copy_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "claims_emitted": {"type": "integer", "minimum": 0},
        "nothing_marked_verified": {"type": "boolean"},
        "kf_result_schema": {"type": "object"},
        "asset_manifest_schema": {"type": "object"}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}

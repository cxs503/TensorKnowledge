{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cxs503/TensorKnowledge/blob/main/schemas/benchmark-card.schema.json",
  "title": "Benchmark Card",
  "description": "A benchmark card captures: case + reference value + tolerance + historical results. Linked with tensor_benchmark_cases/REPRO/XVAL three-line same key. It is a specialization of the claim record (claim_type=predictive) for benchmark results.",
  "type": "object",
  "required": [
    "id",
    "card_type",
    "benchmark_case",
    "reference",
    "created_at",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^tkc:[a-z][a-z0-9-]*:[a-z0-9][a-z0-9-]*$"
    },
    "card_type": {
      "const": "benchmark"
    },
    "benchmark_case": {
      "type": "object",
      "required": ["case_id", "description"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "geometry": { "type": "object" },
        "boundary_conditions": { "type": "array", "items": { "type": "string" } },
        "parameters": { "type": "object" },
        "solver": { "type": "string" },
        "mesh_or_resolution": { "type": "string" }
      },
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "required": ["value", "source"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string" },
        "source": { "type": "string", "minLength": 1 },
        "source_type": { "enum": ["experiment", "dns", "analytical", "literature", "standard", "other"] },
        "doi": { "type": "string" },
        "uncertainty": { "type": "number" },
        "tolerance_pct": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "results_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["got", "run_id"],
        "properties": {
          "got": { "type": "number" },
          "run_id": { "type": "string", "minLength": 1 },
          "solver_version": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "rel_error_pct": { "type": "number" },
          "within_tolerance": { "type": "boolean" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "linked_keys": {
      "type": "object",
      "description": "Keys linking to tensor_benchmark_cases, REPRO, and XVAL lines",
      "properties": {
        "tensor_benchmark_cases": { "type": "string" },
        "repro_key": { "type": "string" },
        "xval_key": { "type": "string" }
      },
      "additionalProperties": false
    },
    "claim_type": {
      "const": "predictive"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "epistemic_status": {
      "enum": ["draft", "established", "well-supported", "provisional", "contested", "speculative", "superseded", "not-assessed"]
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^tke:[a-z][a-z0-9-]*:[a-z0-9][a-z0-9-]*$" },
      "uniqueItems": true
    },
    "scope": {
      "type": "object",
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "system": { "type": "string" },
        "conditions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "modality": {
      "enum": ["asserted", "conditional", "probabilistic", "hypothetical", "normative", "question"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "supersedes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.v1.wp-10344-01.schema.json",
  "title": "asset_manifest.v1 (package wp-10344-01, task_type=01-asset-registration)",
  "description": "Package-pinned schema for the asset_manifest.json of wp-10344-01 (report 10344). It pins the shape actually emitted by scripts/kf_wp10344_01_register.py so that acceptance item schema_pass is a reproducible check rather than an assertion. Field names follow the kf_result.v1 envelope plus the asset_manifest.v1 shape used by earlier packages (wp-448-01, wp-1610-01). If the platform-side registry schema differs, the platform gate wins and this artifact must be revised.",
  "type": "object",
  "required": [
    "schema",
    "package_id",
    "task_type",
    "report_id",
    "source_uri",
    "source_field",
    "source_hash",
    "counts",
    "assets",
    "claims",
    "integrity"
  ],
  "properties": {
    "schema": {"const": "asset_manifest.v1"},
    "package_id": {"const": "wp-10344-01"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"const": "10344"},
    "source_uri": {"const": "tensor://reports/10344"},
    "source_field": {"const": "markdown"},
    "source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_hash_expected": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_hash_matches": {"type": "boolean"},
    "hash_algorithm": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "scenario_key": {"type": "string", "minLength": 1},
    "chars": {"type": "integer", "minimum": 1},
    "bytes_utf8": {"type": "integer", "minimum": 1},
    "heading_count": {"type": "integer", "minimum": 1},
    "headings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "origin", "markdown_token_resolvable"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "caption": {"type": ["string", "null"]},
          "origin": {"const": "record.figures"},
          "markdown_token": {"type": "string", "minLength": 1},
          "markdown_token_resolvable": {"type": "boolean"}
        }
      }
    },
    "attachments_note": {"type": "string"},
    "external_reference_scan": {
      "type": "object",
      "required": ["pattern", "hits"],
      "properties": {
        "pattern": {"type": "string", "minLength": 1},
        "hits": {"type": "integer", "minimum": 0},
        "distinct": {"type": "array", "items": {"type": "string"}}
      }
    },
    "counts": {
      "type": "object",
      "required": ["assets", "by_class", "by_resolution", "resolved_in_source", "referenced_unresolved", "declared_absent"],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object"},
        "by_resolution": {"type": "object"},
        "resolved_in_source": {"type": "integer", "minimum": 0},
        "referenced_unresolved": {"type": "integer", "minimum": 0},
        "declared_absent": {"type": "integer", "minimum": 0}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "asset_class", "label", "in_report_section", "locator", "resolution", "resolution_check", "note"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_class": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "resolution": {"enum": ["resolved_in_source", "referenced_unresolved", "declared_absent"]},
          "resolution_check": {
            "type": "object",
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string", "minLength": 1},
              "result": {"enum": ["resolved", "unresolved", "absent", "present"]},
              "occurrences": {"type": "integer", "minimum": 0},
              "hits": {"type": "integer", "minimum": 0}
            }
          },
          "locator": {
            "type": "object",
            "required": ["method", "start_char", "end_char", "start_line", "end_line", "quote", "unique"],
            "properties": {
              "method": {"enum": ["char_span", "document"]},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 1},
              "end_line": {"type": "integer", "minimum": 1},
              "quote": {"type": "string", "minLength": 1},
              "unique": {"type": "boolean"}
            }
          },
          "attachment_metadata_present": {"type": "boolean"},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate for this package (register_assets only, classify_report_type=false). Each claim, if any, must carry evidence or an explicit status.",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "anyOf": [{"required": ["evidence"]}, {"required": ["status"]}]
      }
    },
    "claims_note": {"type": "string"},
    "integrity": {
      "type": "object",
      "required": ["quote_uniqueness", "hash_recomputed_locally", "hash_matches_contract"],
      "properties": {
        "quote_uniqueness": {
          "type": "object",
          "required": ["quotes", "unique_quotes", "all_resolvable"],
          "properties": {
            "quotes": {"type": "integer", "minimum": 1},
            "unique_quotes": {"type": "integer", "minimum": 0},
            "all_resolvable": {"type": "boolean"}
          }
        },
        "hash_recomputed_locally": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "hash_matches_contract": {"type": "boolean"}
      }
    }
  }
}
{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://github.com/cxs503/TensorKnowledge/blob/main/schemas/kf_result.v1.schema.json", "title": "KF-RESULT v1 — 报告→知识产线工序结果", "description": "报告→知识产线（KBM-RCI-F1-FACTORY）各工序（01 资产登记 / 02 分类解析 / 03 知识抽取 / 04 独立审核 / 05 综合研究）的机器可校验结果。provenance.source_hash 必须与 source_uri 所指报告的 markdown 字节哈希一致（平台独立重算，不一致判门失败）。", "type": "object", "additionalProperties": false, "required": ["package_id", "task_type", "report_id", "provenance", "outputs"], "properties": {"package_id": {"type": "string", "pattern": "^wp-[a-z0-9][a-z0-9-]{2,63}$", "description": "稳定工作包标识。一报告一工序一包，不复用。"}, "task_type": {"enum": ["01-asset-registration", "02-classification-parse", "03-knowledge-extraction", "04-independent-review", "05-synthesis-research"], "description": "五工序之一。"}, "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$", "const": "1.0", "description": "契约版本。"}, "report_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$", "description": "tensor_reports.id 的源报告。"}, "provenance": {"type": "object", "additionalProperties": false, "required": ["source_uri", "source_field", "source_hash"], "properties": {"source_uri": {"type": "string", "pattern": "^(https?://\\S+|file://\\S+|tensor://\\S+)$", "description": "源报告位置。"}, "source_field": {"enum": ["markdown", "summary", "record"], "description": "source_hash 覆盖的报告字段。"}, "source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "源报告 markdown 字节哈希（平台独立重算）。"}, "source_hash_matches": {"type": "boolean", "description": "本工序独立重算的哈希与 source_uri 声明是否一致。"}, "title": {"type": "string"}, "scenario_key": {"type": "string"}, "chars": {"type": "integer"}}}, "outputs": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"asset_manifest.json": {"type": "object", "description": "01 资产登记产物：源哈希 + 附件清单 + 可达性。"}, "classification.json": {"type": "object", "description": "02 分类解析产物。"}, "claims.json": {"type": "array", "description": "03 知识抽取产物（可为空数组）。"}, "evidence.json": {"type": "array", "description": "03 知识抽取产物。"}, "provenance.json": {"type": "array", "description": "03 知识抽取产物。"}, "extraction_summary.json": {"type": "object", "description": "03 知识抽取产物。"}, "review_report.json": {"type": "object", "description": "04 独立审核产物。"}, "review_events.json": {"type": "array", "description": "04 独立审核产物：审核决策事件账本。"}, "synthesis.json": {"type": "object", "description": "05 综合研究产物。"}}}}}
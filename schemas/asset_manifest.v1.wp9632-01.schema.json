{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/asset_manifest.v1.wp9632-01.schema.json",
  "title": "asset_manifest.v1 pinned for KF work package wp-9632-01 (task_type=01-asset-registration)",
  "description": "Derived from schemas/asset_manifest.v1.schema.json (which is pinned to report 448) by replacing the identity consts with this package's, so that acceptance item schema_pass is a reproducible machine check for wp-9632-01 instead of an assertion. Scope of change vs the 448 file: package_id/report_id/source.uri consts; assets[].locator additionally allows quote_form/occurrences_in_source provenance keys (the 448 schema has no additionalProperties:false, so these stay valid there too). If the platform-side schema differs, the platform gate wins and this artefact must be revised.",
  "type": "object",
  "required": ["schema", "package_id", "task_type", "report_id", "source", "counts", "assets", "claims", "integrity"],
  "properties": {
    "schema": {"const": "asset_manifest.v1"},
    "package_id": {"const": "wp-9632-01"},
    "task_type": {"const": "01-asset-registration"},
    "report_id": {"const": "9632"},
    "source": {
      "type": "object",
      "required": ["uri", "field", "hash_alg", "hash", "chars", "bytes_utf8", "title", "scenario_key"],
      "properties": {
        "uri": {"const": "tensor://reports/9632"},
        "field": {"const": "markdown"},
        "hash_alg": {"const": "sha256"},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "chars": {"type": "integer", "minimum": 1},
        "bytes_utf8": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "scenario_key": {"type": "string", "minLength": 1},
        "platform_figures": {"type": "array"},
        "platform_tags": {"type": "array"}
      }
    },
    "counts": {
      "type": "object",
      "required": ["assets", "by_class", "by_resolution", "resolved_in_source", "referenced_unresolved", "declared_absent"],
      "properties": {
        "assets": {"type": "integer", "minimum": 1},
        "by_class": {"type": "object"},
        "by_resolution": {"type": "object"},
        "resolved_in_source": {"type": "integer", "minimum": 0},
        "referenced_unresolved": {"type": "integer", "minimum": 0},
        "declared_absent": {"type": "integer", "minimum": 0}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "asset_class", "label", "in_report_section", "locator", "resolution", "resolution_check", "note"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "asset_class": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "in_report_section": {"type": "string", "minLength": 1},
          "resolution": {"enum": ["resolved_in_source", "referenced_unresolved", "declared_absent"]},
          "resolution_check": {
            "type": "object",
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string"},
              "result": {"enum": ["resolved", "unresolved", "absent", "present"]}
            }
          },
          "locator": {
            "type": "object",
            "required": ["method", "start_char", "end_char", "start_line", "end_line", "quote", "unique"],
            "properties": {
              "method": {"enum": ["char_span", "document"]},
              "start_char": {"type": "integer", "minimum": 0},
              "end_char": {"type": "integer", "minimum": 1},
              "start_line": {"type": "integer", "minimum": 0},
              "end_line": {"type": "integer", "minimum": 0},
              "quote": {"type": "string", "minLength": 1},
              "unique": {"type": "boolean"},
              "quote_form": {"enum": ["token", "line"]},
              "occurrences_in_source": {"type": "integer", "minimum": 1}
            }
          },
          "note": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Empty is legitimate for this package (objective.classify_report_type=false, no extraction). Each claim, if any, must carry an evidence locator or an explicit status.",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "anyOf": [{"required": ["evidence_locator"]}, {"required": ["status"]}]
      }
    },
    "integrity": {
      "type": "object",
      "required": ["quote_uniqueness", "hash_recomputed_locally", "hash_matches_contract"]
    }
  }
}